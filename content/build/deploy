#!/usr/bin/env bash
# build/deploy — universal pipeline entry point
#
# Usage:
#   ./build/deploy --env=<env> --intent=<deploy|release> \
#                  [--tag=<tag>] [--skip-tests] [--skip-gates] [--dry-run]
#
# --env is REQUIRED. There is no default environment. Available environments
# are folders under build/environments/.
#
# --intent declares DIRECTION and is enforced by gates/class-guard.sh:
#   deploy   -> dev / staging. Can never reach production.
#   release  -> production, tagged.
# --intent is REQUIRED as of v0.45.0.
#
# --skip-gates skips the OPTIONAL gates (clean tree, tag match). It has
# never been able to skip class-guard or the production approval, and
# before v0.44.0 it did not skip anything at all — it was parsed, printed
# as "Gates: SKIPPED", and never read.
#
# Synced from claude-kit; safe to customize if you need project-specific
# argument handling. If you customize, /sync will surface the divergence.

set -euo pipefail

# ─── Locate build dir relative to this script ──────────────────────────────
BUILD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$BUILD_DIR/.." && pwd)"
cd "$PROJECT_DIR"

# rasa_actor — the ONE actor-resolution order across the Element.
#
#   RASA_ACTOR  -> set by a runner, CI job or agent harness. The knob.
#   git identity -> the human configured in this clone.
#   OS user      -> last resort.
#
# Canonical definition: stamps.md, "Stamp: run" -> actor. Before this existed,
# five sites called $(whoami) directly, so a service account running an agent
# was recorded in the ledger exactly as a human would be.
rasa_actor() {
  local a="${RASA_ACTOR:-}"
  [ -n "$a" ] || a="$(git config user.name 2>/dev/null || true)"
  [ -n "$a" ] || a="$(whoami 2>/dev/null || true)"
  [ -n "$a" ] || a="${USER:-unknown}"
  printf '%s' "$a"
}

# ─── Defaults ──────────────────────────────────────────────────────────────
ENV=""
INTENT=""
TAG=""
SKIP_TESTS=false
SKIP_GATES=false
DRY_RUN=false

# ─── Parse args ────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case $1 in
    --env=*)        ENV="${1#*=}" ;;
    --env)          ENV="$2"; shift ;;
    --intent=*)     INTENT="${1#*=}" ;;
    --intent)       INTENT="$2"; shift ;;
    --tag=*)        TAG="${1#*=}" ;;
    --tag)          TAG="$2"; shift ;;
    --skip-tests)   SKIP_TESTS=true ;;
    --skip-gates)   SKIP_GATES=true ;;
    --dry-run)      DRY_RUN=true ;;
    -h|--help)
      grep '^#' "$0" | head -20
      exit 0
      ;;
    *)
      echo "ERROR: unknown arg: $1"
      echo "Run with --help for usage."
      exit 2
      ;;
  esac
  shift
done

# ─── Require --env ─────────────────────────────────────────────────────────
if [[ -z "$ENV" ]]; then
  echo "ERROR: --env=<environment> is required."
  echo ""
  echo "Available environments:"
  if [[ -d "$BUILD_DIR/environments" ]]; then
    for d in "$BUILD_DIR"/environments/*/; do
      [[ -d "$d" ]] || continue
      echo "  - $(basename "$d")"
    done
  fi
  exit 2
fi

# ─── Validate environment exists ───────────────────────────────────────────
ENV_DIR="$BUILD_DIR/environments/$ENV"
if [[ ! -d "$ENV_DIR" ]]; then
  echo "ERROR: environment '$ENV' not found at $ENV_DIR"
  echo ""
  echo "Available environments:"
  for d in "$BUILD_DIR"/environments/*/; do
    [[ -d "$d" ]] || continue
    echo "  - $(basename "$d")"
  done
  exit 2
fi

# ─── Source env vars ───────────────────────────────────────────────────────
if [[ -f "$ENV_DIR/env.sh" ]]; then
  # shellcheck disable=SC1091
  source "$ENV_DIR/env.sh"
fi

# env.sh is sourced into THIS shell, so a committed env.sh can reassign the
# paths the driver resolves its gates through. Measured: `BUILD_DIR=/tmp/evil`
# in env.sh made a stub class-guard run and allowed --intent=deploy into a
# prod-class environment — i.e. it defeats the one gate documented as having
# no bypass. Re-derive both paths from this script's own location.
#
# Deliberately NOT `readonly`: an env.sh assigning a readonly variable is fatal
# under `set -e`, which would hard-break any consumer already doing so.
# Re-derivation is idempotent and breaks nobody.
BUILD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$BUILD_DIR/.." && pwd)"

# Export pipeline-wide vars accessible to stages and deploy scripts
export ENVIRONMENT="$ENV"

# The environment skill — present when the project set up the
# environment registry; absent otherwise (the pipeline still works).
ENV_SH="$PROJECT_DIR/.claude/skills/environment/environment.sh"

# DEPLOY_TAG: an explicit --tag wins; else the canonical
# v<semver>-<sha>-<env> string from the environment registry; else
# git describe (for projects without the environment skill).
DEPLOY_TAG=""
if [[ -n "$TAG" ]]; then
  DEPLOY_TAG="$TAG"
elif [[ -f "$ENV_SH" ]]; then
  DEPLOY_TAG="$(bash "$ENV_SH" version "$ENV" 2>/dev/null || true)"
fi
DEPLOY_TAG="${DEPLOY_TAG:-$(git describe --tags --always 2>/dev/null || echo 'untagged')}"
export DEPLOY_TAG

# PUBLISH_TO / DEPLOY_TO: the cloud-stamp targets the registry declares
# for this environment (empty when unset, or when there is no registry).
# Stages and environments/<env>/deploy.sh route on these.
export PUBLISH_TO=""
export DEPLOY_TO=""
if [[ -f "$ENV_SH" ]]; then
  PUBLISH_TO="$(bash "$ENV_SH" get "$ENV" publish_to 2>/dev/null || true)"
  DEPLOY_TO="$(bash "$ENV_SH" get "$ENV" deploy_to 2>/dev/null || true)"
fi

export DEPLOY_USER="$(rasa_actor)"
export DEPLOY_TIMESTAMP="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"

# ─── Resolve direction, then enforce it ────────────────────────────────────
# ENV_CLASS is exported so stages route on the class instead of re-matching
# the environment NAME, which is how `production-us` used to take no gate.
ENV_CLASS="unclassified"
if [[ -f "$ENV_SH" ]]; then
  ENV_CLASS="$(bash "$ENV_SH" class "$ENV" 2>/dev/null || true)"
fi
case "$ENV_CLASS" in
  dev|staging|prod) ;;
  *)
    # Escalate-only name heuristic. Token test, matching gates/class-guard.sh
    # and environment.sh. This used to be a substring test (*prod*|*live*),
    # which disagreed with class-guard and escalated preprod / non-prod /
    # reproduction-test / alive-service to production: `--env=preprod` printed
    # "class-guard: deploy → preprod (class: unclassified)" and then bannered
    # "(class: prod)" on the very next line. Token-prod is a strict subset of
    # substring-prod, so reconciling only ever relaxes the driver — it never
    # un-guards anything class-guard calls prod.
    _lower="$(printf '%s' "$ENV" | tr '[:upper:]' '[:lower:]')"
    ENV_CLASS="unclassified"
    case "$_lower" in
      *preprod*|*pre-prod*|*pre_prod*|*nonprod*|*non-prod*|*non_prod*|*notprod*|*not-prod*|*not_prod*)
        ;;
      *)
        for _tok in $(printf '%s' "$_lower" | tr '\-_.' '   '); do
          case "$_tok" in
            prod*|live*) ENV_CLASS="prod" ;;
          esac
        done
        ;;
    esac
    unset _lower _tok
    ;;
esac
export ENV_CLASS

# --intent is REQUIRED as of v0.45.0. v0.44.0 derived it from the class with
# a deprecation warning; that window is closed. Deriving direction silently
# is how "I thought I was deploying to staging" happens.
if [[ -z "$INTENT" ]]; then
  echo "ERROR: --intent=<deploy|release> is required." >&2
  echo "" >&2
  echo "  deploy  → dev / staging. Cannot reach production." >&2
  echo "  release → production, tagged." >&2
  echo "" >&2
  echo "  '$ENV' has class '$ENV_CLASS'." >&2
  exit 2
fi
export INTENT

case "$INTENT" in
  deploy|release) ;;
  *)
    echo "ERROR: --intent must be 'deploy' or 'release' (got '$INTENT')." >&2
    exit 2
    ;;
esac

# Not skippable. --skip-gates does not reach this, and there is no bypass
# variable: it is the one check the deploy/release split exists to make.
"$BUILD_DIR/gates/class-guard.sh" "$ENV" "$INTENT"

# Same contract, same placement, for the same reason: a gate suite that runs no
# tests is not a gate. Measured before this existed — a fresh install shipped a
# full production release having executed zero tests and exited 0.
#
# This is the only placement nothing bypasses. In 30-test.sh both --skip-tests
# and --dry-run skip the stage before it runs; in 10-preflight.sh --dry-run
# skips it. Here, --skip-tests, --skip-gates, --dry-run, and SKIP_TESTS /
# SKIP_GATES / DRY_RUN set in the environment or assigned by env.sh all still
# run it. There is no bypass variable, by design.
"$BUILD_DIR/gates/tests-required.sh" "$ENV"

# --skip-tests is REFUSED at prod class rather than honored. Measured before
# this: with a deliberately failing test wired into the suite, --skip-tests at
# prod gave exit 0, ran no tests, SHIPPED, and filed a plain ✓ in the deploys
# ledger. This also closes the env.sh vector — env.sh is sourced earlier and
# could set SKIP_TESTS=true, and ENV_CLASS is resolved after that source, so
# the same refusal catches both. Mirrors the guard 10-preflight.sh already
# applies to --skip-gates. Below prod class the flag still works.
if [[ "$SKIP_TESTS" == "true" && "$ENV_CLASS" == "prod" ]]; then
  {
    echo "✗ --skip-tests: REFUSED — '$ENV' is class prod."
    echo ""
    echo "  Skipping tests on the way to production is the failure this"
    echo "  pipeline exists to prevent. Below prod class the flag still works."
    echo ""
    echo "  To ship without running a test, remove it from the suite — an"
    echo "  explicit, reviewable edit — rather than silencing the gate."
  } >&2
  exit 2
fi

# ─── Ship log ──────────────────────────────────────────────────────────────
# Opened AFTER the guard so a refused run leaves no record — a refusal is
# not a deploy. Closed in every exit path below.
#
# APPROVAL records how the human consented, not whether a prompt appeared.
# For a release driven by /release, invocation IS the consent (the skill
# publishes that contract); recording an approver for a prompt that never
# fired would be a lie in an audit trail. A human running this by hand on a
# terminal still gets gates/approval.sh in 10-preflight.
DEPLOYS_SH="$PROJECT_DIR/.claude/skills/deploys/deploys.sh"
SHIP_ID=""
if [[ -f "$DEPLOYS_SH" ]]; then
  SHIP_ID="$(bash "$DEPLOYS_SH" open "$ENV" "$ENV_CLASS" "$INTENT" "$DEPLOY_TAG" \
              "${DEPLOY_APPROVAL:-invocation}" 2>/dev/null || true)"
fi
export SHIP_ID

ship_close() {
  [[ -n "$SHIP_ID" && -f "$DEPLOYS_SH" ]] || return 0
  bash "$DEPLOYS_SH" close "$SHIP_ID" "$1" "$2" "${3:-}" >/dev/null 2>&1 || true
}

# ─── Banner ────────────────────────────────────────────────────────────────
echo "════════════════════════════════════════════════════════════"
echo "  ${INTENT} → $ENV  (class: $ENV_CLASS)"
echo "  Tag:  $DEPLOY_TAG"
[[ -n "$PUBLISH_TO" ]] && echo "  Publish → $PUBLISH_TO"
[[ -n "$DEPLOY_TO" ]]  && echo "  Target  → $DEPLOY_TO"
echo "  User: $DEPLOY_USER"
echo "  Time: $DEPLOY_TIMESTAMP"
$DRY_RUN  && echo "  Mode: DRY RUN (no execution)"
$SKIP_TESTS && echo "  Tests: SKIPPED (refused at prod class)"
$SKIP_GATES && echo "  Gates: SKIPPED (optional gates only — class-guard and prod approval still run)"
echo "════════════════════════════════════════════════════════════"

# ─── Run stages in numeric order ───────────────────────────────────────────
START=$(date +%s)
RESULT="success"
ERROR_STAGE=""

# Collect stages by name to run in sorted order
STAGES=()
for s in "$BUILD_DIR"/stages/*.sh; do
  [[ -f "$s" ]] || continue
  STAGES+=("$s")
done
IFS=$'\n' STAGES=($(sort <<<"${STAGES[*]}")); unset IFS

for stage in "${STAGES[@]}"; do
  STAGE_NAME=$(basename "$stage" .sh)

  # --skip-tests skips any stage whose name contains "test".
  # Refused outright at prod class above, so this only ever runs below it.
  if [[ "$SKIP_TESTS" == "true" && "$STAGE_NAME" == *test* ]]; then
    echo "▷ $STAGE_NAME (skipped: --skip-tests)"
    continue
  fi

  echo ""
  echo "▶ Stage: $STAGE_NAME"
  echo "───────────────────────────────────────────────────────────"

  if [[ "$DRY_RUN" == "true" ]]; then
    echo "  (dry-run: not executing)"
    continue
  fi

  if ! SKIP_GATES="$SKIP_GATES" bash "$stage" "$ENV"; then
    RESULT="failed"
    ERROR_STAGE="$STAGE_NAME"
    echo ""
    echo "✗ Stage failed: $STAGE_NAME"
    break
  fi
done

END=$(date +%s)
DURATION=$((END - START))

# ─── Log result ────────────────────────────────────────────────────────────
if [[ "$DRY_RUN" == "true" ]]; then
  ship_close "success" "$DURATION" "dry-run"
elif [[ "$RESULT" == "success" ]]; then
  ship_close "success" "$DURATION"
else
  ship_close "failed" "$DURATION" "$ERROR_STAGE"
fi

# Legacy single-line log. Superseded by the deploys/ ledger — kept because
# projects that already have build/deploy-log.md would otherwise see their
# history stop without explanation. Delete the file to stop the append.
LOG="$BUILD_DIR/deploy-log.md"
if [[ -f "$LOG" ]]; then
  STATUS_MARK="✓"
  NOTES=""
  if [[ "$RESULT" == "failed" ]]; then
    STATUS_MARK="✗"
    NOTES="failed at $ERROR_STAGE"
  fi
  if [[ "$DRY_RUN" == "true" ]]; then
    NOTES="${NOTES:+$NOTES; }dry-run"
  fi
  echo "| $DEPLOY_TIMESTAMP | $ENV | $DEPLOY_USER | $DEPLOY_TAG | $STATUS_MARK | ${DURATION}s | $NOTES |" >> "$LOG"
fi

# ─── Exit code ─────────────────────────────────────────────────────────────
echo ""
if [[ "$RESULT" == "success" ]]; then
  echo "✓ ${INTENT} complete: $ENV (${DURATION}s)"
  [[ -n "$SHIP_ID" ]] && echo "  recorded: $SHIP_ID"
  exit 0
else
  echo "✗ ${INTENT} failed at stage: $ERROR_STAGE"
  [[ -n "$SHIP_ID" ]] && echo "  recorded: $SHIP_ID"
  exit 1
fi
