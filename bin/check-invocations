#!/usr/bin/env bash
#
# bin/check-invocations — shipped commands must be invocable as written.
#
# WHY
#
# v0.45.0 made `--intent` mandatory on `./build/deploy`. Twelve shipped
# call sites still omitted it, including /setup-deploy's own verification
# step — so the skill that sets up the pipeline told you to run a command
# that exits 2. Hand-enumeration missed half of them on the first pass,
# which is the argument for a gate rather than a sweep.
#
# An example in shipped documentation is a command a consumer will paste.
# If it cannot run, the documentation is wrong in the most expensive way.
#
# Exit: 0 clean, 1 findings.
#
# Portability: bash 3.2 (stock macOS).

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *)  script_path="$(cd "$(dirname "$script_path")" && pwd)/$link_target" ;;
  esac
done
cd "$(cd "$(dirname "$script_path")/.." && pwd)"

findings=0
advisories=0
STRICT="${STRICT:-0}"
case "${1:-}" in --strict) STRICT=1 ;; esac

report() {
  printf '✗ %s:%s\n' "$1" "$2"
  printf '   %s\n' "$3"
  printf '   → %s\n\n' "$4"
  findings=$(( findings + 1 ))
}

# Collect into a variable first: a `while read` fed by a pipe runs in a
# subshell, so `findings` would not survive the loop.
hits=""

# --- 1. ./build/deploy requires --intent as of v0.45.0 -----------------
hits="$(grep -rn 'build/deploy --env' content/ seed/ 2>/dev/null || true)"
while IFS= read -r hit; do
  [ -n "$hit" ] || continue
  case "$hit" in *--intent*) continue ;; esac
  file="${hit%%:*}"; rest="${hit#*:}"; line="${rest%%:*}"; text="${rest#*:}"
  report "$file" "$line" "$text" \
    "build/deploy requires --intent=<deploy|release> since v0.45.0; as written this exits 2."
done < <(printf '%s\n' "$hits")

# --- 2. every /slash-command named in shipped docs must exist ----------
# A skill referenced by name that has no folder is a dead end for whoever
# follows the instruction.
#
# ADVISORY by default, hard under --strict. The first honest run surfaced
# real dangling references AND Claude Code built-ins, and a gate that
# fails CI on the built-ins is a gate someone disables. Built-ins are
# allowlisted below; what remains is a content decision, not a bug.
BUILTINS="help init clear compact config review code-review security-review agents model cost memory doctor login logout permissions hooks vim terminal-setup resume ultrareview loop schedule"

known=""
for d in content/skills/*/; do
  [ -d "$d" ] || continue
  known="$known $(basename "${d%/}")"
done

hits="$(grep -rnoE '`/[a-z][a-z0-9-]+`' content/ 2>/dev/null || true)"
seen=""
while IFS= read -r hit; do
  [ -n "$hit" ] || continue
  file="${hit%%:*}"; rest="${hit#*:}"; line="${rest%%:*}"; tok="${rest#*:}"
  name="$(printf '%s' "$tok" | tr -d '`/')"
  # Skip things that are paths or known non-skill words.
  case "$name" in ''|*/*) continue ;; esac
  case " $known " in *" $name "*) continue ;; esac
  case " $BUILTINS " in *" $name "*) continue ;; esac
  # Report each missing name once.
  case " $seen " in *" $name "*) continue ;; esac
  seen="$seen $name"
  if [ "${STRICT:-0}" = "1" ]; then
    report "$file" "$line" "/$name" \
      "no content/skills/$name/ — a reader following this finds nothing."
  else
    printf '  advisory: %s:%s references /%s, which ships no skill\n' "$file" "$line" "$name"
    advisories=$(( advisories + 1 ))
  fi
done < <(printf '%s\n' "$hits")

echo ""
if [ "$advisories" -gt 0 ]; then
  printf '%d advisory finding(s) — dangling /slash references. Re-run with --strict to gate on them.\n' "$advisories"
fi
if [ "$findings" -gt 0 ]; then
  printf 'bin/check-invocations: %d finding(s).\n' "$findings"
  echo "Shipped examples are commands consumers paste. They must run."
  exit 1
fi
echo "bin/check-invocations: clean."
exit 0
