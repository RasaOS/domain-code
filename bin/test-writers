#!/usr/bin/env bash
# bin/test-writers — regression tests for the record writers that run inside
# an installed project. Repo tooling: lives in bin/, is not registered in
# rasa.json, and is never installed into a consumer.
#
# Every section installs this checkout into a fresh project with bin/init and
# drives the real skills there, the way a consumer's session would.
#
#   task-guard   the change-ledger row keeps its shape for a clean actor; an
#                actor carrying a newline cannot add a row; removing the hook
#                block keeps the hook file's mode and the other hooks in it.
#
# Portable on purpose: bash 3.2, POSIX tools. Exit 0 only if every case passes.

set -u
here="$(cd "$(dirname "$0")" && pwd -P)"
ELEMENT="$(cd "$here/.." && pwd -P)"

T="$(mktemp -d "${TMPDIR:-/tmp}/test-writers.XXXXXX")" || exit 2
T="$(cd "$T" && pwd -P)"
trap 'rm -rf "$T"' EXIT
export GIT_CONFIG_GLOBAL=/dev/null HOME="$T/home"
mkdir -p "$HOME"
unset RASA_ROOT RASA_ACTOR

pass=0; fail=0
ok()  { pass=$((pass + 1)); printf '  ✓ %s\n' "$1"; }
bad() { fail=$((fail + 1)); printf '  ✗ %s\n' "$1"; }

# install <dir> — a fresh git project with this Element installed into it.
install() {
  mkdir -p "$1" && git -C "$1" init -q
  git -C "$1" config user.name "Test Person"; git -C "$1" config user.email t@t
  "$ELEMENT/bin/init" "$1" >/dev/null 2>&1 || { echo "bin/init failed for $1" >&2; exit 2; }
  printf 'kit/\n' >> "$1/.gitignore"
  git -C "$1" add -A >/dev/null 2>&1; git -C "$1" commit -qm install >/dev/null 2>&1
}

echo "task-guard"
P="$T/tg"; install "$P"
( cd "$P" && bash .claude/skills/task-guard/task-guard.sh on >/dev/null 2>&1 )
mkdir -p "$P/src"; echo 'a = 1' > "$P/src/a.py"
( cd "$P" && git add src/a.py && git commit -qm first >/dev/null 2>&1 )
L="$P/tasks/CHANGES.md"
row="$(awk '/^## /{n++} n==1' "$L")"
[ "$(printf '%s\n' "$row" | sed -n '2p')" = '- **Author.** Test Person' ] \
  && ok "the Author line is the actor, byte-for-byte" || bad "author line: $(printf '%s\n' "$row" | sed -n '2p')"
printf '%s\n' "$row" | grep -qE '^## [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} — TASK-[0-9]+$' \
  && ok "the row heading keeps its shape" || bad "row heading: $(printf '%s\n' "$row" | head -1)"
[ "$(printf '%s\n' "$row" | sed -n '4p')" = '- **Files.** src/a.py' ] \
  && ok "the Files line lists the staged path" || bad "files line: $(printf '%s\n' "$row" | sed -n '4p')"

rows_before="$(grep -c '^## ' "$L")"
echo 'b = 2' > "$P/src/b.py"
( cd "$P" && git add src/b.py \
  && RASA_ACTOR="$(printf 'mallory\n## 2020-01-01 00:00 — TASK-000')" git commit -qm second >/dev/null 2>&1 ) \
  && ok "a newline in RASA_ACTOR does not block the commit" || bad "the commit was blocked"
[ "$(grep -c '^## ' "$L")" = $((rows_before + 1)) ] && ok "exactly one new row — none forged" \
  || bad "rows: $rows_before -> $(grep -c '^## ' "$L")"
grep -q '^## 2020-01-01' "$L" && bad "a forged row landed in the ledger" || ok "no forged row"
tail -5 "$L" | grep -qF -- '- **Author.** (refused: the actor identity carried a control character)' \
  && ok "the refused identity is recorded as refused" || bad "author: $(tail -5 "$L" | grep Author)"

H="$(git -C "$P" rev-parse --git-common-dir)/hooks/pre-commit"
case "$H" in /*) ;; *) H="$P/$H" ;; esac
{ echo '#!/usr/bin/env bash'; echo 'echo other-hook'; cat "$H" | tail -n +2; } > "$H.new" && mv "$H.new" "$H"
chmod 755 "$H"
( cd "$P" && bash .claude/skills/task-guard/task-guard.sh off >/dev/null 2>&1 )
[ -x "$H" ] && ok "removing task-guard keeps the shared hook executable" || bad "the hook lost its exec bit: $(ls -l "$H" | cut -c1-10)"
grep -q 'echo other-hook' "$H" && ok "the other hook's line is kept" || bad "the other hook was removed"
grep -q 'task-guard' "$H" && bad "task-guard's block is still there" || ok "task-guard's block is gone"
ls -A "$(dirname "$H")" | grep -q '^\.task-guard\.' && bad "a temp file was left in hooks/" || ok "no temp file left in hooks/"

echo
echo "test-writers: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
