def run(c):
    p = json.dumps({"tool_input": {"command": c}, "cwd": cwd})
    r = subprocess.run(["bash", ".claude/skills/land/land.sh", "guard-bash"], input=p, capture_output=True, text=True, cwd=cwd)
    return '"deny"' in r.stdout
bad = []
for c in DENY:
    if not run(c): bad.append(("should DENY", c))
for c in ALLOW:
    if run(c): bad.append(("should ALLOW", c))
print("cases=%d misclassified=%d" % (len(DENY) + len(ALLOW), len(bad)))
for b in bad: print("  %s: %r" % b)
PYTABLE
)"
expect "the Bash guard classifies all of the table" 0 0 "misclassified=0" "$out"

echo
echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
