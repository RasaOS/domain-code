echo "guards"
bash "$L" hooks >/dev/null 2>&1
out="$(bash "$L" hooks 2>&1)"
expect "hooks are idempotent" 0 0 "prepush: present" "$out"
n="$(python3 -c 'import json;d=json.load(open(".claude/settings.json"));print(sum(1 for g in d["hooks"]["PreToolUse"] for h in g["hooks"] if "guard-bash" in h["command"] and "land.sh" in h["command"]))')"
[ "$n" = 1 ] && ok "  one guard-bash entry after two installs" || bad "  one guard-bash entry after two installs" "$n"
gb() { python3 -c 'import json,sys; print(json.dumps({"tool_input":{"command":sys.argv[1]},"cwd":sys.argv[2]}))' "$1" "$P" | bash "$L" guard-bash; }
denied() { printf '%s' "$1" | grep -q '"deny"'; }
for c in "git push origin main" "git push origin HEAD:main" "git push origin feat:refs/heads/main" "git push --all origin" \
         "git push --mirror" "git push" "git push -u origin HEAD" "git -c core.hooksPath=/dev/null push origin feat" \
         "git config core.hooksPath /tmp/x" "GIT_GUARD_ALLOW_MAIN=1 git push" "git commit --no-verify -m x" \
         "git commit -nm x" "git push --no-verify origin feat" "rm .git/hooks/pre-push" "bash -c 'git push origin main'" \
         "gh api -X PUT repos/o/r/pulls/5/merge" "gh api repos/o/r/merges -f base=main -f head=feat" "git push origin :main" \
         "git push origin HEAD:heads/main" "CLAUDECODE= git push origin feat" "env -u CLAUDECODE git push origin feat" \
         "git remote set-head origin feat" "git send-pack ../r HEAD:refs/heads/main" "git --config-env=core.hooksPath=X push origin feat" \
         "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null git push origin feat" \
         "git push --no-ver origin feat" "timeout 60 git push --no-verify origin feat" "gh api --method=PUT repos/o/r/pulls/5/merge" \
         "gh api graphql -f query='mutation { mergeBranch(input:{}) { clientMutationId } }'" "cd .git && rm hooks/pre-push" \
         "git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/feat"; do
  out="$(gb "$c")"
  denied "$out" && ok "deny: $c" || bad "deny: $c" "allowed: $out"
done
for c in "git push origin land/x" "git push origin v1.0.0" "git push --tags origin" "git push -n origin feat" \
         "echo 'git push origin main'" "git commit -m 'use -n flag'" "ls .git/hooks" "gh pr merge 5 --squash --match-head-commit abc" \
         "git config --get core.hooksPath" "bash .claude/skills/land/land.sh docs --skill a --title t -- x.md" "git pull --ff-only origin main" \
         "git config --unset core.hooksPath" "git commit -F - <<'EOF'
Don't run git push origin main or --no-verify
EOF" "git log --oneline --grep 'push main'"; do
  out="$(gb "$c")"
  denied "$out" && bad "allow: $c" "denied: $out" || ok "allow: $c"
done
gm() { python3 -c 'import json,sys; print(json.dumps({"tool_name":sys.argv[1],"tool_input":{"branch":sys.argv[2]},"cwd":sys.argv[3]}))' "$1" "$2" "$P" | bash "$L" guard-mcp; }
denied "$(gm mcp__github__push_files main)" && ok "deny: MCP push_files to main" || bad "deny: MCP push_files to main" "allowed"
denied "$(gm mcp__plugin_x_github__create_or_update_file main)" && ok "deny: a differently named server's create_or_update_file to main" || bad "deny: renamed server" "allowed"
denied "$(gm mcp__github__delete_file '')" && ok "deny: MCP delete_file with no branch (the default branch)" || bad "deny: delete_file no branch" "allowed"
denied "$(gm mcp__github__push_files land/x)" && bad "allow: MCP push_files to land/x" "denied" || ok "allow: MCP push_files to land/x"
ge() { python3 -c 'import json,sys; print(json.dumps({"tool_name":"Write","tool_input":{"file_path":sys.argv[1]}}))' "$1" | bash "$L" guard-edit; }
denied "$(ge "$P/.git/hooks/pre-push")" && ok "deny: Write into .git/hooks" || bad "deny: Write into .git/hooks" "allowed"
denied "$(ge "$P/docs/audits/x.md")" && bad "allow: Write a doc" "denied" || ok "allow: Write a doc"
git checkout -q main; git commit -q --allow-empty -m "try the trunk"
out="$(CLAUDECODE=1 git push origin main 2>&1)"; rc=$?
[ "$rc" != 0 ] && has "refused" "$out" && ok "pre-push: Claude cannot move the trunk" || bad "pre-push: Claude cannot move the trunk" "rc=$rc $out"
out="$(CLAUDECODE=1 git push origin HEAD:refs/heads/land/probe 2>&1)"; rc=$?
[ "$rc" = 0 ] && ok "pre-push: a branch push passes" || bad "pre-push: a branch push passes" "rc=$rc $out"
git remote add mirror "$R"
out="$(CLAUDECODE=1 git push mirror main 2>&1)"; rc=$?
[ "$rc" != 0 ] && ok "pre-push: a second remote name for the same URL is caught" || bad "pre-push: second remote" "rc=$rc"
out="$(git push -q origin main 2>&1)"; rc=$?
[ "$rc" = 0 ] && ok "pre-push: a human (no CLAUDECODE) pushing the trunk is not refused" || bad "pre-push: human" "rc=$rc $out"
git commit -q --allow-empty -m "try again"
git remote set-head origin land/probe >/dev/null 2>&1
out="$(CLAUDECODE=1 git push origin main 2>&1)"; rc=$?
[ "$rc" != 0 ] && ok "pre-push: re-pointing origin/HEAD does not unguard main" || bad "pre-push: set-head bypass" "rc=$rc $out"
git remote set-head origin main >/dev/null 2>&1
git reset -q --hard origin/main
# Another tool's hook: a python pre-push is kept whole, chained, and gets
# stdin byte for byte (empty when nothing is pushed).
H="$(git rev-parse --git-common-dir)/hooks"
printf '#!/usr/bin/env python3\nimport sys\nopen("%s/py-hook.log","a").write("[%%s]" %% sys.stdin.read())\n' "$T" > "$H/pre-push.py-tmp"
mv "$H/pre-push" "$H/pre-push.land-saved"; mv "$H/pre-push.py-tmp" "$H/pre-push"; chmod +x "$H/pre-push"
bash "$L" hooks >/dev/null 2>&1
[ -x "$H/pre-push.land-chained" ] && grep -q python3 "$H/pre-push.land-chained" && ok "hooks: a python pre-push is kept as a chained hook" || bad "hooks: python hook chained" "$(ls "$H")"
git push -q origin main 2>/dev/null
[ "$(cat "$T/py-hook.log" 2>/dev/null)" = "[]" ] && ok "  it gets empty stdin on an up-to-date push" || bad "  empty stdin" "$(cat "$T/py-hook.log" 2>/dev/null)"
# A foreign block written into our hook (git-guard on) survives a re-install.
printf '# >>> git-guard >>>\n# git-guard pre-push block\n# <<< git-guard <<<\n' >> "$H/pre-push"
bash "$L" hooks >/dev/null 2>&1; bash "$L" session >/dev/null 2>&1
grep -q "git-guard pre-push block" "$H/pre-push" && ok "hooks/session keep another tool's block in pre-push" || bad "foreign block kept" "$(cat "$H/pre-push")"

echo "push.sh — never drops commits when it cuts from the fresh trunk"
clean
advance
git commit -q --allow-empty -m "local trunk commit"
LOCAL="$(git rev-parse HEAD)"
out="$(bash .claude/skills/push/push.sh run --message x 2>&1)"; rc=$?
git merge-base --is-ancestor "$LOCAL" HEAD && ok "push.sh keeps an unpushed trunk commit on the new branch" || bad "push.sh keeps the local commit" "$out"
git checkout -q main; git reset -q --hard origin/main

