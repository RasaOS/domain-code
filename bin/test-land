import json, subprocess, sys
cwd = sys.argv[1]
DENY = [
 "git push origin main", "git push origin HEAD:main", "git push origin +HEAD:main", "git push -f origin main",
 "git push --force-with-lease origin main", "git push origin HEAD:refs/heads/main", "git push origin heads/main",
 "git push origin feat:main", "git push origin :main", "git push --delete origin main", "git push -d origin main",
 "git push origin master", "git push origin @:main", "git push origin main:main", "git push", "git push -u origin HEAD",
