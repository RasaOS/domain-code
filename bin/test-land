expect "a read of an earlier head is refused" 3 "$rc" "read it again" "$out"
printf '{"headRefOid":"%s","statusCheckRollup":[{"__typename":"CheckRun","name":"ci","status":"COMPLETED","conclusion":"SUCCESS"}]}' "$QS" > "$T/ro-ok.json"
