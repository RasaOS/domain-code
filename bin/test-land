cat > "$T/round4-3.py" <<'PY'
import os, sys, time, queue, multiprocessing
sys.path.insert(0, sys.argv[1]); import land
repo = land.Repo(sys.argv[2])
lk = os.path.join(repo.state, "lock")
real_stale = land.Lock._stale
def slow_stale(self):
    # A waiter descheduled right after judging the lock stale: the window a
    # takeover must survive (another waiter replaces the lock meanwhile).
    r = real_stale(self)
    if r:
        time.sleep(0.2)
    return r
land.Lock._stale = slow_stale
def worker(i, q):
    with land.Lock(repo):
        t0 = time.time(); time.sleep(0.05); q.put((t0, time.time()))
ctx = multiprocessing.get_context("fork")  # spawn cannot re-import a script read from stdin
over = 0
for trial in range(3):
    os.makedirs(lk, exist_ok=True)
    open(os.path.join(lk, "owner"), "w").write("999999 %d proc:1 deadbeef\n" % int(time.time()))
    q = ctx.Queue()
    ps = [ctx.Process(target=worker, args=(i, q)) for i in range(8)]
    [p.start() for p in ps]; [p.join(120) for p in ps]
    spans = []
    try:
        for _ in range(8):
            spans.append(q.get(timeout=5))
    except queue.Empty:
        print("crash=%d of 8 never held the lock" % (8 - len(spans)))
    spans.sort()
    over += sum(1 for a, b in zip(spans, spans[1:]) if b[0] < a[1])
    bad = [p.exitcode for p in ps if p.exitcode != 0]
    if bad: print("crash=%s" % bad)
print("overlaps=%d" % over)
PY
out="$(python3 -B "$T/round4-3.py" "$P/.claude/skills/land" "$P" 2>&1)"
