echo "round four — appends, stale bases, failed syncs, planning worktrees"
clean
cat > "$T/round4-1.py" <<'PY'
import os, sys; sys.path.insert(0, sys.argv[1]); import land
repo = land.Repo(os.getcwd()); os.makedirs(repo.state, exist_ok=True)
m = lambda b, o, t: land.merge_bytes(repo, b, o, t, union=True)
unread = b"# Inbox\n\n### `#0001` `[unread]` from `@t`\nhi\n"
read = b"# Inbox\n\n### `#0001` `[read]` from `@t` *(read)*\nhi\n"
two = b"# Inbox\n\n### `#0002` `[unread]` from `@u`\nyo\n"
v1 = b"# Notes\nn1\nn2\nn3\nn4\nn5\nn6\n"
fixed = v1.replace(b"n5\n", b"n5 FIXED\n")
msg1 = b"### `#0001` `[unread]` from `@a`\n\nhello\n\n---\n\n"
msg2 = b"### `#0002` `[unread]` from `@b`\n\nLGTM\n\n---\n\n"
msg3 = b"### `#0003` `[unread]` from `@c`\n\nLGTM\n\n---\n\n"
cases = [
    ("a message added in two versions", m(b"", unread, read) is None),
    ("a flip on one side is an edit", m(unread, unread, read) == read),
    ("two appends keep both", (m(b"# Inbox\n", unread, two) or b"").count(b"`#000") == 2),
    ("appends clash beside an edit elsewhere", m(v1, fixed + b"n10\n", v1 + b"n11\n") == fixed + b"n10\nn11\n"),
    ("one line edited both ways", m(b"a\nb\nc\n", b"a\nB1\nc\n", b"a\nB2\nc\n") is None),
    ("an edit next to the other side's append", m(b"a\nb\n", b"a\nB\n", b"a\nb\nc\n") is None),
    ("two clashes a blank line apart keep that line once", m(b"a\n\nb\n", b"a\nX1\n\nX2\nb\n", b"a\nY1\n\nY2\nb\n") == b"a\nX1\nY1\n\nX2\nY2\nb\n"),
    ("a separator is not doubled when one side removed another copy", m(b"top\n\nmid\na\n\nz\n", b"top\nmid\na\nO1\n\nO2\nz\n", b"top\n\nmid\na\nT1\n\nT2\nz\n") == b"top\nmid\na\nO1\nT1\n\nO2\nT2\nz\n"),
    ("each side's addition stays whole", m(b"a\n", b"a\nn10\nn11\n", b"a\nn10\nn12\n") == b"a\nn10\nn11\nn10\nn12\n"),
    ("an identical addition is kept once", m(b"a\n", b"a\nsame\n", b"a\nsame\n") == b"a\nsame\n"),
    ("a record both sides added is never written twice", m(b"a\n", b"a\n- [x](x.md)\nn11\n", b"a\n- [x](x.md)\nn12\n") is None),
    ("two messages with the same body and trailer stay two whole messages", m(msg1, msg1 + msg2, msg1 + msg3) == msg1 + msg2 + msg3),
    ("lines that look like conflict markers", m(b"a\n=======\n", b"a\n=======\nx\n", b"a\n=======\ny\n") == b"a\n=======\nx\ny\n"),
]
os.environ.update(GIT_CONFIG_COUNT="1", GIT_CONFIG_KEY_0="merge.conflictStyle", GIT_CONFIG_VALUE_0="diff3")
cases.append(("the same under a user's diff3 conflict style", m(v1, fixed + b"n10\n", v1 + b"n11\n") == fixed + b"n10\nn11\n" and m(b"a\n", b"a\nx\n", b"a\ny\n") == b"a\nx\ny\n"))
bad = [name for name, good in cases if not good]
print("union_rules=%s %s" % (not bad, bad))
PY
out="$(python3 -B "$T/round4-1.py" "$P/.claude/skills/land" 2>&1)"
expect "a union keeps both sides' appends and never doubles or drops a line" 0 0 "union_rules=True" "$out"
cat > "$T/round4-2.py" <<'PY'
import base64, os, subprocess, sys; sys.path.insert(0, sys.argv[1]); import land
repo = land.Repo(os.getcwd())
data = ("a start copy gc pruned %s\n" % os.urandom(8).hex()).encode()
blob = subprocess.run(["git", "hash-object", "--stdin"], input=data, stdout=subprocess.PIPE).stdout.decode().strip()
gone = lambda: subprocess.run(["git", "cat-file", "-e", blob], stderr=subprocess.DEVNULL).returncode != 0
entry = {"blob": blob, "head": "e" * 40}
cases = [("not in the object store to begin with", gone()),
         ("pruned, nothing saved: dropped", land.record_base(repo, entry, "e" * 40) == (None, False))]
entry["data"] = base64.b64encode(data).decode()
cases += [("HEAD moved under it: dropped", land.record_base(repo, entry, "f" * 40) == (None, False)),
          ("pruned, content saved: written back", land.record_base(repo, entry, "e" * 40) == (blob, True) and not gone()),
          ("committed since: still the start copy", land.record_base(repo, entry, blob) == (blob, True))]
bad = [name for name, good in cases if not good]
print("record_rules=%s %s" % (not bad, bad))
PY
out="$(python3 -B "$T/round4-2.py" "$P/.claude/skills/land" 2>&1)"
