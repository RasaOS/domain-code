out="$(python3 -B - "$P/.claude/skills/land" <<'PY' 2>&1
import sys; sys.path.insert(0, sys.argv[1]); import land
b = "land/audit-20260101-000000-abcd"
cases = [("on: push\n", True), ("on: [push, workflow_dispatch]\n", True),
         ("on:\n  push:\n    branches: [main]\n", False),
         ("on:\n  push:\n    branches:\n      - main\n      - 'land/**'\n", True),
         ("on:\n  push:\n    branches-ignore: [land/**]\n", False),
         ("on:\n  push:\n    tags: ['v*']\n", False),
         ("on:\n  pull_request:\n", True), ("on:\n  workflow_dispatch:\n", False)]
print("bad=%r" % [t for t, w in cases if land.workflow_runs_for(t, b) != w])
PY
)"
expect "CI detection: push and pull_request triggers, with branch filters" 0 0 "bad=\[\]" "$out"
out="$(python3 -B - "$P/.claude/skills/land" <<'PY' 2>&1
import sys; sys.path.insert(0, sys.argv[1]); import land
def name(skill, title):
    a = land.Args(); a.branch, a.tasks, a.skill, a.title = "", [], skill, title
    return land.branch_name(a, None, stable=True)
n1, n2 = name("brainstorm", "tradeoffs auth-token-storage-vs-cookies-and-sessions-a"), name("brainstorm", "tradeoffs auth-token-storage-vs-cookies-and-sessions-b")
n3, n4 = name("inbox", "messages for charles_romeo"), name("inbox", "messages for charles-romeo")
print("distinct=%s welcome=%s" % (n1 != n2 and n3 != n4, name("handoff", "welcome pointer")))
PY
)"
expect "stable branch names: titles that slug alike get distinct branches" 0 0 "distinct=True welcome=chore/handoff-welcome-pointer" "$out"

