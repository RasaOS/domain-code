#!/usr/bin/env bash
# bin/test-deploy-sync — "deploys never go backwards": gates/trunk-sync.sh,
# gates/live-contained.sh and the standalone checker
# .claude/skills/deploy/deploy-check.sh, driven inside real bin/init installs
# with a local bare remote and two clones — two sessions, one site.
# Repo tooling: lives in bin/, is not registered in rasa.json, and is never
# installed into a consumer. The pipeline driver's own wiring is covered by
# bin/test-pipeline ("deploys never go backwards").
#
#   trunk-sync      tip passes at prod; a synced feature branch passes at
#                   staging and is refused at prod (RELEASE_PR=<n> accepts
#                   it); behind the trunk is refused at prod and staging,
#                   naming the missing commits; ALLOW_BEHIND_TRUNK=1; offline
#                   refuses prod and warns below; DEPLOY_TRUNK and
#                   pipeline-config.toml [git] trunk; no remote at all
#   live-contained  an ancestor passes; a live commit HEAD lacks is refused,
#                   listed; an unknown sha is refused; a sha only on an
#                   unfetched remote branch is fetched first; prod with no
#                   way to know is refused unless LIVE_SHA_UNKNOWN_OK=1;
#                   staging warns; the env.sh live_sha hook, LIVE_SHA_CMD,
#                   `none`, a failing hook; the ship-log fallback (newest
#                   success, dry-runs and failures skipped, records committed
#                   on the trunk); ALLOW_DROP_LIVE=1
#   deploy-check    PASS/REFUSED and exit 0/1/2, --live-sha, --live-cmd,
#                   --prod, any cwd, a monorepo sub-directory install
#
# Portable on purpose: bash 3.2, POSIX tools, git, python3 (bin/init).
# Exit 0 only if every case passes.

set -u
# bin/init installs land.sh's pre-push guard, which refuses Claude's pushes to
# a trunk. These fixtures push their own throwaway trunks.
unset CLAUDECODE
here="$(cd "$(dirname "$0")" && pwd -P)"
ELEMENT="$(cd "$here/.." && pwd -P)"

T="$(mktemp -d "${TMPDIR:-/tmp}/test-deploy-sync.XXXXXX")" || exit 2
T="$(cd "$T" && pwd -P)"
trap 'rm -rf "$T"' EXIT
export GIT_CONFIG_GLOBAL=/dev/null HOME="$T/home"
mkdir -p "$HOME"
unset RASA_ROOT RASA_ACTOR ENV_CLASS DEPLOY_TRUNK RELEASE_PR LIVE_SHA LIVE_SHA_CMD \
      ALLOW_BEHIND_TRUNK ALLOW_DROP_LIVE LIVE_SHA_UNKNOWN_OK

pass=0; fail=0
ok()  { pass=$((pass + 1)); printf '  ok    %s\n' "$1"; }
bad() { fail=$((fail + 1)); printf '  FAIL  %s\n        %s\n' "$1" "$2"; }
# expect <name> <want-rc> <pattern|""> <cmd...> — run, check rc and output.
expect() {
  local name="$1" want="$2" pat="$3" out rc; shift 3
  out="$("$@" 2>&1)"; rc=$?
  if [ "$rc" != "$want" ]; then
    bad "$name" "want rc=$want, got rc=$rc — $(printf '%s' "$out" | grep -E '✗|⚠|error|REFUSED' | head -3 | tr '\n' '|')"
  elif [ -n "$pat" ] && ! printf '%s\n' "$out" | grep -q -- "$pat"; then
    bad "$name" "output lacks /$pat/: $(printf '%s' "$out" | tail -6 | tr '\n' '|')"
  else
    ok "$name"
  fi
}
# lacks <name> <pattern> <cmd...> — the output must NOT match.
lacks() {
  local name="$1" pat="$2" out; shift 2
  out="$("$@" 2>&1)"
  if printf '%s\n' "$out" | grep -q -- "$pat"; then bad "$name" "output has /$pat/"; else ok "$name"; fi
}
gitq() { git "$@" >/dev/null 2>&1; }
mk() { echo "$2" > "$1.txt" && git add -A && git commit -qm "$2"; }

# ── two sessions, one remote ───────────────────────────────────────────────
R="$T/remote.git"; git init -q --bare -b main "$R"
A="$T/a"; mkdir -p "$A" && cd "$A" || exit 2
git init -q -b main . && git config user.email a@example.com && git config user.name sessionA
"$ELEMENT/bin/init" . </dev/null >/dev/null 2>&1 || { echo "bin/init failed"; exit 2; }
for e in staging prod; do mkdir -p "build/environments/$e"; done
printf 'kit/\n' >> .gitignore
git add -A && git commit -qm base
git remote add origin "$R" && gitq push -q origin main
git remote set-head origin main >/dev/null 2>&1
B="$T/b"; git clone -q "$R" "$B" && git -C "$B" config user.email b@example.com && git -C "$B" config user.name sessionB

trunk() { ENV_CLASS="$2" ./build/gates/trunk-sync.sh "$1"; }
live()  { ENV_CLASS="$2" ./build/gates/live-contained.sh "$1"; }

echo "trunk-sync"
cd "$A"
expect "the trunk tip passes at prod" 0 "HEAD is the tip of origin/main" trunk prod prod
gitq checkout -b feat; mk feat "feature work"
expect "a feature branch synced with main passes at staging" 0 "synced" trunk staging staging
expect "a feature branch is refused at prod (not the tip)" 1 "carries 1 commit" trunk prod prod
expect "  … naming the commit it would ship" 1 "feature work" trunk prod prod
expect "RELEASE_PR=<n> lets /release ship its release commit" 0 "release PR #12" env RELEASE_PR=12 ENV_CLASS=prod ./build/gates/trunk-sync.sh prod
expect "  … and says so on stdout for the ship log" 0 "^override=release-pr-12" env RELEASE_PR=12 ENV_CLASS=prod ./build/gates/trunk-sync.sh prod
# session B ships a commit to main; A's checkout has not seen it
( cd "$B" && mk b1 "B's merged feature" && gitq push -q origin main )
gitq checkout main
expect "behind the trunk is refused at prod" 1 "1 commit(s) behind origin/main" trunk prod prod
expect "behind the trunk is refused at staging" 1 "B's merged feature" trunk staging staging
expect "  … with the fix for a lower environment" 1 "git merge origin/main" trunk staging staging
expect "  … and for production" 1 "deploy from origin/main" trunk prod prod
gitq checkout feat
expect "a feature branch missing the new trunk commit is refused at staging" 1 "behind origin/main" trunk staging staging
expect "ALLOW_BEHIND_TRUNK=1 overrides, loudly" 0 "OVERRIDING" env ALLOW_BEHIND_TRUNK=1 ENV_CLASS=staging ./build/gates/trunk-sync.sh staging
expect "  … and reports the override for the ship log" 0 "^override=behind-trunk" env ALLOW_BEHIND_TRUNK=1 ENV_CLASS=staging ./build/gates/trunk-sync.sh staging
gitq merge -q --no-edit origin/main
expect "after git merge origin/main it passes at staging" 0 "synced" trunk staging staging
gitq checkout main; gitq merge -q --ff-only origin/main
expect "main fast-forwarded to the tip passes at prod" 0 "tip of origin/main" trunk prod prod
# offline
git remote set-url origin "$T/nowhere.git"
expect "offline: prod is refused" 1 "could not fetch origin/main" trunk prod prod
expect "offline: staging warns and compares with the last fetch" 0 "may be stale" trunk staging staging
git remote set-url origin "$R"
# the configured trunk
( cd "$B" && git checkout -q -b release && mk r1 "release-only fix" && gitq push -q origin release )
expect "DEPLOY_TRUNK=origin/release is the trunk it checks" 1 "behind origin/release" env DEPLOY_TRUNK=origin/release ENV_CLASS=prod ./build/gates/trunk-sync.sh prod
printf '[project]\nname = "x"\n\n[git]\ntrunk = "release"   # where prod ships from\n' > build/pipeline-config.toml
expect "pipeline-config.toml [git] trunk is honoured" 1 "behind origin/release" trunk prod prod
rm -f build/pipeline-config.toml
# no remote at all
N="$T/noremote"; mkdir -p "$N" && ( cd "$N" && git init -q -b main . && git config user.email n@example.com && git config user.name n \
  && "$ELEMENT/bin/init" . </dev/null >/dev/null 2>&1 && printf 'kit/\n' >> .gitignore && git add -A && git commit -qm base && git checkout -q -b old && git checkout -q main \
  && echo x > x.txt && git add -A && git commit -qm "local-only trunk commit" )
( cd "$N" && expect "no remote: the local main is the trunk (tip passes)" 0 "comparing with the local 'main'" env ENV_CLASS=prod ./build/gates/trunk-sync.sh prod )
( cd "$N" && git checkout -q old && expect "no remote: behind the local main is refused" 1 "local-only trunk commit" env ENV_CLASS=staging ./build/gates/trunk-sync.sh staging )

echo "live-contained"
cd "$A"; gitq checkout main; gitq merge -q --ff-only origin/main
OLD="$(git rev-parse HEAD~1)"; TIP="$(git rev-parse HEAD)"
expect "a live commit that is an ancestor of HEAD passes" 0 "HEAD contains what is live" env LIVE_SHA="$OLD" ENV_CLASS=prod ./build/gates/live-contained.sh prod
expect "  … and prints it for the ship log" 0 "^live_sha=$OLD" env LIVE_SHA="$OLD" ENV_CLASS=prod ./build/gates/live-contained.sh prod
expect "live == HEAD passes" 0 "HEAD contains" env LIVE_SHA="$TIP" ENV_CLASS=staging ./build/gates/live-contained.sh staging
# B deploys a branch that is not on main: live has a commit A lacks
( cd "$B" && git checkout -q main && gitq pull -q --ff-only && git checkout -q -b hotfix && mk hf "B's hotfix, deployed" && gitq push -q origin hotfix )
HF="$(git -C "$B" rev-parse HEAD)"
expect "a live commit only on an unfetched branch is fetched, then refused" 1 "drop 1 live commit" env LIVE_SHA="$HF" ENV_CLASS=staging ./build/gates/live-contained.sh staging
expect "  … listing what would be dropped" 1 "B's hotfix, deployed" env LIVE_SHA="$HF" ENV_CLASS=staging ./build/gates/live-contained.sh staging
expect "  … at prod too" 1 "does not contain it" env LIVE_SHA="$HF" ENV_CLASS=prod ./build/gates/live-contained.sh prod
expect "a short live sha resolves" 1 "drop 1 live commit" env LIVE_SHA="$(git rev-parse --short "$HF")" ENV_CLASS=staging ./build/gates/live-contained.sh staging
expect "a live sha git does not know is refused" 1 "on no branch you have" env LIVE_SHA=0123456789abcdef0123456789abcdef01234567 ENV_CLASS=staging ./build/gates/live-contained.sh staging
expect "ALLOW_DROP_LIVE=1 overrides, loudly" 0 "OVERRIDING" env ALLOW_DROP_LIVE=1 LIVE_SHA="$HF" ENV_CLASS=staging ./build/gates/live-contained.sh staging
expect "  … and reports the override" 0 "^override=drop-live" env ALLOW_DROP_LIVE=1 LIVE_SHA="$HF" ENV_CLASS=staging ./build/gates/live-contained.sh staging
expect "LIVE_SHA=none (never deployed) passes" 0 "has nothing live" env LIVE_SHA=none ENV_CLASS=prod ./build/gates/live-contained.sh prod
expect "a LIVE_SHA that is not a commit is unknown (refused at prod)" 1 "is unknown" env LIVE_SHA=garbage ENV_CLASS=prod ./build/gates/live-contained.sh prod
# nothing to go on
expect "prod with no hook and no record is refused" 1 "what is live in 'prod' is unknown" live prod prod
expect "  … unless LIVE_SHA_UNKNOWN_OK=1" 0 "^override=live-unknown" env LIVE_SHA_UNKNOWN_OK=1 ENV_CLASS=prod ./build/gates/live-contained.sh prod
expect "staging with no hook and no record warns" 0 "is unknown" live staging staging
# the env.sh hook
printf 'live_sha() { echo "%s"; }\n' "$HF" > build/environments/staging/env.sh
expect "the env.sh live_sha function is read (refuses)" 1 "env.sh live_sha" live staging staging
printf 'live_sha() { [ "$1" = staging ] && echo "deployed: %s (by B)"; }\n' "$OLD" > build/environments/staging/env.sh
expect "  … gets the env name and its sha is picked out of the text (passes)" 0 "HEAD contains" live staging staging
printf 'live_sha() { echo none; }\n' > build/environments/staging/env.sh
expect "  … none means nothing is live" 0 "has nothing live" live staging staging
printf 'live_sha() { return 3; }\n' > build/environments/prod/env.sh
expect "a failing hook is unknown, refused at prod" 1 "live hook (env.sh live_sha) failed" live prod prod
printf 'LIVE_SHA_CMD="printf %%s %s"\n' "$HF" > build/environments/prod/env.sh
expect "LIVE_SHA_CMD in env.sh is read" 1 "LIVE_SHA_CMD" live prod prod
expect "LIVE_SHA in the environment wins over the hook" 0 "LIVE_SHA" env LIVE_SHA="$OLD" ENV_CLASS=prod ./build/gates/live-contained.sh prod
rm -f build/environments/staging/env.sh build/environments/prod/env.sh
# the ship-log fallback
rec() { # rec <dir> <name> <env> <status> <sha> [error_stage]
  mkdir -p "$1"; printf -- '---\nid: %s\nkind: deploy\nenvironment: %s\nclass: staging\ntag: t\nsha: %s\nstatus: %s\nerror_stage: %s\n---\n\n# %s\n' \
    "$2" "$3" "$5" "$4" "${6:-}" "$2" > "$1/$2.md"; }
D=deploys/records
rec "$D" DEP-20261001-100000-staging staging success "$(git rev-parse --short "$OLD")"
expect "the newest successful record is the live commit (passes)" 0 "ship log DEP-20261001-100000-staging" live staging staging
rec "$D" DEP-20261002-100000-staging staging success "$(git rev-parse --short "$HF")"
expect "  … a newer record of a commit HEAD lacks refuses" 1 "B's hotfix, deployed" live staging staging
rec "$D" DEP-20261003-100000-staging staging success "$(git rev-parse --short "$OLD")" dry-run
rec "$D" DEP-20261003-110000-staging staging failed "$(git rev-parse --short "$OLD")"
rec "$D" DEP-20261003-120000-staging staging in-flight "$(git rev-parse --short "$OLD")"
expect "  … dry-run, failed and in-flight records are skipped" 1 "DEP-20261002-100000-staging" live staging staging
rec "$D" DEP-20261004-100000-pre-staging pre-staging success "$(git rev-parse --short "$HF")"
rec "$D" DEP-20261004-100000-staging-2 staging success "$(git rev-parse --short "$TIP")"
expect "  … another environment's record is not this one's; a same-second -2 is newest" 0 "DEP-20261004-100000-staging-2" live staging staging
rm -rf deploys
# a record committed on the trunk by the other session
( cd "$B" && git checkout -q main && rec deploys/records DEP-20261005-100000-prod prod success "$(git rev-parse --short "$HF")" \
  && git add -A && git commit -qm "B's ship log" && gitq push -q origin main )
gitq fetch -q origin
expect "a record committed on the trunk is read (refuses)" 1 "(on origin/main)" live prod prod

echo "deploy-check"
cd "$A"; gitq checkout -q main; gitq merge -q --ff-only origin/main
DC="$A/.claude/skills/deploy/deploy-check.sh"
OLD="$(git rev-parse HEAD~1)"
expect "PASS and exit 0 at the tip with an ancestor live" 0 "^PASS" "$DC" --env prod --prod --live-sha "$OLD"
expect "REFUSED and exit 1 with a live commit HEAD lacks (--live-sha)" 1 "^REFUSED" "$DC" --env prod --prod --live-sha "$HF"
expect "REFUSED via --live-cmd" 1 "B's hotfix, deployed" "$DC" --env staging --live-cmd "echo $HF"
expect "PASS via --live-cmd" 0 "^PASS" "$DC" --env staging --live-cmd "echo $OLD"
( cd "$B" && mk b2 "B again" && gitq push -q origin main )
expect "REFUSED behind the trunk (exit 1) before it looks at live" 1 "behind origin/main" "$DC" --env prod --prod --live-sha "$OLD"
lacks "  … and does not go on to the live check" "live-contained" "$DC" --env prod --prod --live-sha "$OLD"
gitq merge -q --ff-only origin/main
gitq checkout -q -b f2; mk f2 "unmerged"
expect "--prod refuses a commit that is not the tip" 1 "carries 1 commit" "$DC" --env web --prod --live-sha none
expect "without --prod the name decides (staging passes)" 0 "^PASS" "$DC" --env staging --live-sha none
expect "a prod-looking name is prod without --prod" 1 "REFUSED" "$DC" --env live-eu --live-sha none
expect "--trunk-only skips the live check" 0 "^PASS" "$DC" --env staging --trunk-only
expect "no --env is a usage error (exit 2)" 2 "required" "$DC" --live-sha none
expect "--live-sha with --live-cmd is a usage error (exit 2)" 2 "not both" "$DC" --env x --live-sha none --live-cmd true
gitq checkout -q main
mkdir -p "$A/deep/er"
( cd "$A/deep/er" && expect "works from a sub-directory of the repository" 0 "^PASS" "$DC" --env staging --live-sha none )
( cd / && expect "works from outside the repository" 0 "^PASS" "$DC" --env staging --live-sha none )
# a monorepo: the install lives in app/
M="$T/mono"; MR="$T/mono.git"; git init -q --bare -b main "$MR"
mkdir -p "$M/app" && ( cd "$M" && git init -q -b main . && git config user.email m@example.com && git config user.name m \
  && ( cd app && "$ELEMENT/bin/init" . </dev/null >/dev/null 2>&1 ) && printf 'app/kit/\n' > .gitignore && echo s > shared.txt && git add -A && git commit -qm mono \
  && git remote add origin "$MR" && gitq push -q origin main && git remote set-head origin main >/dev/null 2>&1 )
MB="$T/mono-b"; git clone -q "$MR" "$MB" && ( cd "$MB" && git config user.email mb@example.com && git config user.name mb && mk shared "B in the monorepo" && gitq push -q origin main )
( cd "$M/app" && expect "monorepo sub-directory install: refuses behind the trunk" 1 "B in the monorepo" ./.claude/skills/deploy/deploy-check.sh --env staging --live-sha none )
( cd "$M" && gitq merge -q --ff-only origin/main && cd / && expect "  … and passes once synced, called from anywhere" 0 "^PASS" "$M/app/.claude/skills/deploy/deploy-check.sh" --env staging --live-sha none )
( cd "$M/app" && expect "  … and its gates run there too" 0 "tip of origin/main" env ENV_CLASS=prod ./build/gates/trunk-sync.sh prod )

echo
echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
