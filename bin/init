#!/usr/bin/env bash
#
# rasa.domain.core init — minimal canonical installer for the
# domain Element template.
#
# Usage:
#   bin/init [target-dir]
#
# If [target-dir] is omitted, the current working directory is used.
#
# This script is the Element-primitive installer per canon
# ELEMENT_CONTRACT.md §7 (install policies). What gets installed
# is declared entirely in rasa.json — this script holds NO
# hardcoded file list. It reads the Connection Contract and applies
# each entry in element.files[] and seed.files[] by its declared
# policy.
#
# For domain-core specifically: element.files[] entries are all
# policy 'opt-in' (the v1.1.0 starter layer ships but is NOT installed
# until a fork flips a policy), so an init here installs nothing from
# content/. seed.files[] has the two canonical templates
# (CLAUDE.md.template + rasa.lock.json.template). So an init here
# mainly writes the lockfile + the project CLAUDE.md.

set -euo pipefail

# ---------- Paths + args ----------

ELEMENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-$(pwd)}"
TARGET="$(cd "$TARGET" && pwd)"

if [[ "$TARGET" == "$ELEMENT_DIR" ]]; then
  echo "✗ Refusing to install into the Element's own folder." >&2
  echo "  Per ELEMENT_CONTRACT — Elements don't install into themselves." >&2
  exit 1
fi

# ---------- Classify the target: greenfield or brownfield ----------
# Decided BEFORE anything is written, so this install's own files cannot
# make a new project look like an established one.
#
# This drives the task-enforcement default. task-enforcement-rules.md argues
# — correctly — that "a gate that switches itself on mid-stream is a gate
# people delete", and that reasoning is why enforcement ships off. But it is
# an argument about EXISTING projects. A brand-new project has no mid-stream,
# and defaulting off there means the gate is never turned on at all.
#
# So: no commits yet, or no tracked files, means greenfield. Anything with
# history is treated as brownfield, which is the cautious direction and keeps
# the shipped rationale intact.
TARGET_GREENFIELD=false
if ! git -C "$TARGET" rev-parse --verify HEAD >/dev/null 2>&1; then
  TARGET_GREENFIELD=true
elif [[ "$(git -C "$TARGET" ls-files 2>/dev/null | wc -l | tr -d ' ')" == "0" ]]; then
  TARGET_GREENFIELD=true
fi

# Whether the consumer already owns this file decides if we may set its
# default at all — it is skip-if-exists, and an existing setting is theirs.
TE_JSON="$TARGET/.claude/task-enforcement.json"
TE_PREEXISTING=false
[[ -f "$TE_JSON" ]] && TE_PREEXISTING=true

# ---------- Read rasa.json ----------

MANIFEST="$ELEMENT_DIR/rasa.json"

if [[ ! -f "$MANIFEST" ]]; then
  echo "✗ rasa.json not found at $MANIFEST" >&2
  exit 1
fi

# Resolve Element identity for lockfile stamping
ELEMENT_NAME="$(python3 -c "import json; print(json.load(open('$MANIFEST'))['name'])")"
ELEMENT_KIND="$(python3 -c "import json; print(json.load(open('$MANIFEST'))['kind'])")"
ELEMENT_VERSION="$(python3 -c "import json; print(json.load(open('$MANIFEST'))['version'])")"
ELEMENT_REPO="$(python3 -c "import json; print(json.load(open('$MANIFEST'))['source']['repo'])")"
ELEMENT_BRANCH="$(python3 -c "import json; print(json.load(open('$MANIFEST'))['source']['branch'])")"

# Resolve current Element SHA.
#
# `rev-parse HEAD` is the wrong idiom here: in a repo with no commits it
# prints "HEAD" on stdout AND exits non-zero, so a `|| echo uncommitted`
# fallback appends a SECOND line and the stamped lockfile ends up with a
# raw newline inside a JSON string — invalid JSON. Every Element freshly
# created by `bin/new-element` (git init, no commit yet) hits that.
# `--verify --quiet` prints nothing and exits 1 when HEAD is unresolvable.
ELEMENT_SHA="$(git -C "$ELEMENT_DIR" rev-parse --verify --quiet HEAD 2>/dev/null || true)"
if [[ -z "$ELEMENT_SHA" || "$ELEMENT_SHA" == *[!0-9a-f]* ]]; then
  ELEMENT_SHA="uncommitted"
fi
TODAY="$(date -u +%Y-%m-%d)"

echo "→ Installing $ELEMENT_NAME @ $ELEMENT_VERSION ($ELEMENT_SHA)"
echo "  into: $TARGET"
echo ""

# A non-numeric count means the manifest read FAILED, not that the list is
# empty. `[[ "$x" -eq 0 ]]` evaluates an unparseable value as 0, so without
# this guard a broken manifest reports "empty — nothing to copy" and exits
# 0 having installed nothing. Fail loudly instead. See CHANGELOG 0.43.1.
require_count() {
  local label="$1" value="$2"
  case "$value" in
    ''|*[!0-9]*)
      echo "✗ init: could not read $label from $MANIFEST (got: '$value')." >&2
      echo "  Refusing to continue — a partial install is worse than none." >&2
      exit 1
      ;;
  esac
}

# ---------- Apply element.files[] ----------

count_elem="$(python3 -c "import json; print(len(json.load(open('$MANIFEST')).get('element', {}).get('files', [])))")"

require_count "element.files[]" "$count_elem"

if [[ "$count_elem" -eq 0 ]]; then
  echo "  element.files[] empty — domain-core v0.x ships zero content."
else
  echo "  Applying $count_elem element.files[] entries..."
  python3 - "$MANIFEST" "$ELEMENT_DIR" "$TARGET" <<'PYEOF'
import json, os, shutil, sys

manifest_path, element_dir, target = sys.argv[1], sys.argv[2], sys.argv[3]
manifest = json.load(open(manifest_path))

# `overrides[]` is the consumer's list of files they have deliberately
# diverged and do NOT want overwritten. bin/init PRESERVED the list across
# a re-run but never READ it, so the one thing it exists to protect was
# destroyed on every re-install — including build/stages/20-build.sh, which
# /setup-deploy writes the project's real build command into and which
# reverts to a `TODO: configure` stub that exits 1. With /sync dead,
# re-running bin/init IS the update path, so this was the update path
# breaking the project it updated.
overrides = set()
lock = os.path.join(target, '.claude', 'rasa.lock.json')
try:
    with open(lock) as fh:
        for entry in (json.load(fh).get('overrides') or []):
            overrides.add(os.path.normpath(str(entry)))
except (OSError, ValueError):
    pass

kept = []


def protected(rel):
    """True if rel — or a directory containing it — is overridden."""
    rel = os.path.normpath(rel)
    if rel in overrides:
        return True
    for o in overrides:
        if rel.startswith(o.rstrip(os.sep) + os.sep):
            return True
    return False


def mirror(src, dst, rel_base):
    """copytree that honours overrides. shutil.copytree cannot skip
    per-file, so the walk is done here."""
    for root, _dirs, files in os.walk(src):
        sub = os.path.relpath(root, src)
        out = dst if sub == '.' else os.path.join(dst, sub)
        os.makedirs(out, exist_ok=True)
        for name in files:
            rel = os.path.normpath(os.path.join(
                rel_base, '' if sub == '.' else sub, name))
            if protected(rel):
                kept.append(rel)
                continue
            shutil.copy2(os.path.join(root, name), os.path.join(out, name))


for entry in manifest.get('element', {}).get('files', []):
    src = os.path.join(element_dir, entry['from'])
    dst = os.path.join(target, entry['to'])
    policy = entry['policy']
    if policy == 'opt-in':
        continue  # not installed automatically — create nothing in the target
    # Only materialize the target directory for policies that write.
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if policy == 'directory-mirror':
        if os.path.isdir(src):
            mirror(src, dst, entry['to'])
    elif policy == 'file-replace':
        if protected(entry['to']):
            kept.append(os.path.normpath(entry['to']))
            continue
        shutil.copy2(src, dst)
    else:
        print(f"  ⚠ unknown element.files[] policy: {policy} for {entry['from']}", file=sys.stderr)

for rel in sorted(set(kept)):
    print(f"    · keep (overridden): {rel}")
PYEOF
fi

# ---------- Upgrade a pre-1.0 task ledger ----------
# From 0.53.0 the task system is rasa.module.tasks v1.0.0 (vendored). A
# project installed from an earlier version keeps a 0.x ledger — status:
# fields, five stages, categories — that the new .claude/bin/check-tasks
# rejects outright. A re-run of this script is the update path, so it
# migrates that ledger here, BEFORE the seeds below.
#
# The order is load-bearing. tasks/tasks.config.yml carries the schema
# marker migrate-tasks reads as "already converted"; seeding it over an
# unconverted ledger would hide that ledger from the migration for good.
# So if the migration cannot run, every tasks/ seed is held back instead.
#
# bin/migrate-ledger applies only over a clean tasks/: the result is left
# uncommitted, one reviewable diff, with git as the undo.
HOLD_TASK_SEEDS=false
LEDGER_NOTE=""
if [[ -d "$TARGET/tasks" ]] \
   && ! grep -qs '^schema: rasa.module.tasks/1.0.0' "$TARGET/tasks/tasks.config.yml"; then
  legacy=false
  for st in triage backlog active review blocked completed done; do
    [[ -d "$TARGET/tasks/$st" ]] && legacy=true
  done
  if [[ "$legacy" == true ]]; then
    echo "  Task ledger: pre-1.0 shape found — migrating to rasa.module.tasks v1.0.0..."
    set +e
    ml_out="$(python3 "$ELEMENT_DIR/bin/migrate-ledger" --apply "$TARGET" 2>&1)"
    ml_rc=$?
    set -e
    printf '%s\n' "$ml_out" | grep -E '^(  prepare:|migrate-ledger:|summary:|The migrated|migrate-tasks: (abort|refusing))' \
      | sed 's/^ *//; s/^/    · /' || true
    case "$ml_rc" in
      0) LEDGER_NOTE="migrated to rasa.module.tasks v1.0.0 — uncommitted; read tasks/MIGRATION-REVIEW.md, review, commit" ;;
      1) LEDGER_NOTE="migrated, but .claude/bin/check-tasks still reports errors — run it, fix, then commit" ;;
      *) HOLD_TASK_SEEDS=true
         LEDGER_NOTE="NOT migrated — tasks/ seeds held back. Fix what is named above, then run: $ELEMENT_DIR/bin/migrate-ledger --apply $TARGET"
         printf '%s\n' "$ml_out" | grep -vE '^(  prepare:|migrate-ledger:|summary:|The migrated)' \
           | tail -n 8 | sed 's/^/      /' >&2 || true ;;
    esac
  fi
fi

# ---------- Apply seed.files[] ----------

count_seed="$(python3 -c "import json; print(len(json.load(open('$MANIFEST')).get('seed', {}).get('files', [])))")"

require_count "seed.files[]" "$count_seed"

if [[ "$count_seed" -eq 0 ]]; then
  echo "  seed.files[] empty — no one-time files to copy."
else
  echo "  Applying $count_seed seed.files[] entries..."
  python3 - "$MANIFEST" "$ELEMENT_DIR" "$TARGET" \
    "$ELEMENT_NAME" "$ELEMENT_KIND" "$ELEMENT_VERSION" \
    "$ELEMENT_REPO" "$ELEMENT_BRANCH" "$ELEMENT_SHA" "$TODAY" \
    "$HOLD_TASK_SEEDS" <<'PYEOF'
import json, os, shutil, sys

(manifest_path, element_dir, target,
 elem_name, elem_kind, elem_version,
 elem_repo, elem_branch, elem_sha, today, hold_tasks) = sys.argv[1:12]
hold_tasks = (hold_tasks == 'true')

manifest = json.load(open(manifest_path))

subs = {
    '{{ELEMENT_NAME}}':    elem_name,
    '{{ELEMENT_KIND}}':    elem_kind,
    '{{ELEMENT_VERSION}}': elem_version,
    '{{ELEMENT_REPO}}':    elem_repo,
    '{{ELEMENT_BRANCH}}':  elem_branch,
    '{{ELEMENT_SHA}}':     elem_sha,
    '{{TODAY}}':           today,
}

# Consumer-owned keys survive a re-stamp; Element-owned keys are refreshed.
# `overrides` is the consumer's deliberate list of files they have diverged
# and do not want overwritten. `installed_at` is a historical fact about the
# first install. Unknown keys are assumed consumer-added and kept.
CONSUMER_OWNED = ('overrides',)


def merge_stamp(dst, new_text, today):
    """Merge a freshly-substituted stamp over an existing one.

    Returns (text, None) on success or (None, reason) when the existing file
    cannot be understood — in which case the caller must leave it alone.
    Overwriting an unparseable lockfile would destroy the very overrides
    this function exists to protect.
    """
    try:
        with open(dst) as fh:
            old = json.load(fh)
        new = json.loads(new_text)
    except (ValueError, OSError) as exc:
        return None, type(exc).__name__
    if not isinstance(old, dict) or not isinstance(new, dict):
        return None, 'not a JSON object'

    merged = dict(new)
    for key in CONSUMER_OWNED:
        if key in old:
            merged[key] = old[key]
    if 'installed_at' in old:
        merged['installed_at'] = old['installed_at']
    for key, value in old.items():
        if key not in merged:
            merged[key] = value
    merged['last_synced'] = today
    return json.dumps(merged, indent=2) + '\n', None


for entry in manifest.get('seed', {}).get('files', []):
    src = os.path.join(element_dir, entry['from'])
    dst = os.path.join(target, entry['to'])
    policy = entry['policy']

    if hold_tasks and entry['to'].startswith('tasks/'):
        print(f"    · hold (pre-1.0 ledger not migrated): {entry['to']}")
        continue

    if policy == 'skip-if-exists' and os.path.exists(dst):
        print(f"    · skip (exists): {entry['to']}")
        continue

    # The re-stamp below merges JSON, and exists for the lockfile. Any other
    # init-only-with-sha file (tasks/tasks.config.yml) is written once and is
    # the project's afterwards — a re-run must not try to parse it as JSON
    # and then tell the consumer to delete it.
    if (policy == 'init-only-with-sha' and os.path.exists(dst)
            and not dst.endswith('.json')):
        print(f"    · skip (exists): {entry['to']}")
        continue

    os.makedirs(os.path.dirname(dst), exist_ok=True)

    if policy == 'init-only-with-sha':
        with open(src) as f:
            content = f.read()
        for k, v in subs.items():
            content = content.replace(k, v)

        if os.path.exists(dst):
            # A re-run is the update path (there is no working /sync), so it
            # must refresh the pin WITHOUT destroying consumer state. Before
            # 0.43.1 this branch did not exist: re-running bin/init silently
            # reset `overrides[]` to [], and the next sync then overwrote
            # every file the consumer had deliberately protected.
            merged, why = merge_stamp(dst, content, today)
            if merged is None:
                print(f"    \u26a0 keep (unmergeable, {why}): {entry['to']}"
                      f" \u2014 pin NOT refreshed; fix or delete the file",
                      file=sys.stderr)
            else:
                with open(dst, 'w') as f:
                    f.write(merged)
                print(f"    \u00b7 restamp (overrides preserved): {entry['to']}")
        else:
            with open(dst, 'w') as f:
                f.write(content)
            print(f"    \u00b7 stamp: {entry['to']}")
    elif policy in ('skip-if-exists', 'file-replace'):
        # skip-if-exists already handled the exists case above. A
        # file-replace seed (the _template-* files) is refreshed on every
        # install/sync — unless the consumer kept it in overrides[].
        if policy == 'file-replace' and os.path.exists(dst):
            try:
                _ov = json.load(open(os.path.join(target, '.claude', 'rasa.lock.json'))).get('overrides') or []
            except (OSError, ValueError):
                _ov = []
            if os.path.normpath(entry['to']) in {os.path.normpath(str(o)) for o in _ov}:
                print(f"    · keep (overrides[]): {entry['to']}")
                continue
        shutil.copy2(src, dst)
        print(f"    · copy: {entry['to']}")
    else:
        print(f"    ⚠ unknown seed.files[] policy: {policy} for {entry['from']}", file=sys.stderr)
PYEOF
fi

# ---------- Set the task-enforcement default for a NEW project ----------
# Only ever touches a file this run created. A pre-existing
# .claude/task-enforcement.json is the consumer's own setting (the entry is
# skip-if-exists) and is never rewritten here.
if [[ -f "$TE_JSON" && "$TE_PREEXISTING" == false ]]; then
  if [[ "$TARGET_GREENFIELD" == true ]]; then
    python3 - "$TE_JSON" <<'PYEOF'
import json, sys, collections
p = sys.argv[1]
d = json.load(open(p), object_pairs_hook=collections.OrderedDict)
d['enabled'] = True
d['_enabled_doc'] = (
    "Enabled by bin/init because this was a NEW project at install time — no "
    "commits and no tracked files. There is no mid-stream here to disrupt, so "
    "the gate starts on. Installing into an EXISTING project leaves this false "
    "instead, because a gate that switches itself on mid-stream is a gate "
    "people delete. Toggle with: .claude/skills/task-enforce/task-enforce.sh on|off"
)
json.dump(d, open(p, 'w'), indent=2)
open(p, 'a').write('\n')
PYEOF
    echo "  task-enforcement: ENABLED (new project — no commits at install time)"
  else
    echo "  task-enforcement: left OFF (existing project — turn it on deliberately)"
    echo "    enable with: .claude/skills/task-enforce/task-enforce.sh on"
  fi
fi

# ---------- Clone the Element source into <target>/kit/<folder>/ (the /kit stash) ----------
# A persistent, pinned reference clone of the Element's source repo. It powers
# /sync (smart-pull upstream changes) and /promote (smart-push local changes back
# upstream). Cloned from the local Element dir (fast, no network); origin is
# repointed at the real upstream so /sync + /promote fetch/push GitHub.
ELEMENT_FOLDER="$(basename "$ELEMENT_DIR")"
KIT_DIR="$TARGET/kit/$ELEMENT_FOLDER"
if command -v git >/dev/null 2>&1 && [[ "$ELEMENT_SHA" != "uncommitted" ]]; then
  if [[ -d "$KIT_DIR/.git" ]]; then
    echo "  kit: kit/$ELEMENT_FOLDER already present (left as-is)"
  else
    mkdir -p "$TARGET/kit"
    if git clone --quiet "$ELEMENT_DIR" "$KIT_DIR" 2>/dev/null; then
      git -C "$KIT_DIR" remote set-url origin "$ELEMENT_REPO" 2>/dev/null || true
      git -C "$KIT_DIR" checkout --quiet "$ELEMENT_SHA" 2>/dev/null || true
      echo "  kit: cloned → kit/$ELEMENT_FOLDER (origin $ELEMENT_REPO, pinned ${ELEMENT_SHA:0:12})"
    else
      echo "  kit: ⚠ clone failed for $ELEMENT_FOLDER — /sync + /promote will clone on first use" >&2
    fi
  fi
fi

# ---------- Stamp the RasaOS identity (element layer — regenerated every install) ----------
# Canon SA-025: who this element is, rendered from rasa.identity into
# .claude/rasa-identity.md so any session loading this project immediately knows
# its identity. Regenerated on every install/upgrade (never goes stale). The
# DEPLOYMENT layer is the separate, project-owned .claude/rasa-deployment.md.
python3 - "$MANIFEST" "$TARGET" "$ELEMENT_SHA" "$TODAY" <<'PYEOF'
import json, os, sys
manifest_path, target, sha, today = sys.argv[1:5]
m = json.load(open(manifest_path))
name = m.get('name', ''); kind = m.get('kind', '')
idn = (m.get('rasa') or {}).get('identity') or {}
one  = idn.get('one_liner') or f"a RasaOS {kind}"
role = idn.get('role') or kind
subj = idn.get('subject') or ''
goal = idn.get('goal') or ''
cdir = os.path.join(target, '.claude'); os.makedirs(cdir, exist_ok=True)
has_depl = os.path.exists(os.path.join(cdir, 'rasa-deployment.md'))
depl = ("See `.claude/rasa-deployment.md` for the deployment layer (what this project is, for whom, on what platform)."
        if has_depl else
        "Not filled yet — describe this project in `.claude/rasa-deployment.md` (what it is, for whom, on what platform).")
out = f"""# Who you are — RasaOS identity

*(GENERATED by `bin/init` at install; regenerated on upgrade. Read this first — it is who you are.)*

**RasaOS** — the operating system for agentic AI vertical platforms.

You are **`{name}`** — {one}.

- **Substrate:** RasaOS
- **Element:** `{name}` — a **{role}** for **{subj}**
- **Goal:** {goal}
- **Pinned:** `{sha}` · stamped {today}

## Deployment (the last layer)

{depl}

---

When asked **"who are you?"**, compose the answer across all three layers —
RasaOS + this element + the deployment:

> "I am a RasaOS **{role}** for **{subj}**" + the deployment layer
> (e.g. "…, an iOS product for a company called VSI").

Or run **/whoami**.
"""
open(os.path.join(cdir, 'rasa-identity.md'), 'w').write(out)
print("  identity: generated .claude/rasa-identity.md")
PYEOF

echo ""
echo "✓ $ELEMENT_NAME @ $ELEMENT_VERSION installed into $TARGET"
echo "  Lockfile:  $TARGET/.claude/rasa.lock.json"
[[ -n "$LEDGER_NOTE" ]] && echo "  Ledger:    $LEDGER_NOTE"
echo "  Identity:  $TARGET/.claude/rasa-identity.md (+ rasa-deployment.md — fill it in)"
echo "  Kit stash: $TARGET/kit/$ELEMENT_FOLDER (for /sync + /promote)"
