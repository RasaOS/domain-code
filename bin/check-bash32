#!/usr/bin/env bash
#
# bin/check-bash32 — reject bash 4+ syntax in shipped shell.
#
# WHY THIS EXISTS
#
# `bash -n` is not a portability gate. It parses with whatever bash is
# running, so on a CI box with bash 5 every bash-4-ism parses clean and
# exits 0. Before v0.43.1 all 40 shipped scripts passed `bash -n` while
# `content/build/gates/approval.sh` aborted at runtime on stock macOS
# with `bad substitution` — the production approval gate, unpassable,
# green in CI.
#
# This Element ships to consumers on any machine. `/bin/bash` on macOS
# is 3.2.57 (2007) and Apple will not ship a newer one. So 3.2 is the
# floor, and this script is what holds it.
#
# WHAT IT CHECKS
#
#   1. ${var,,} ${var^^} ${var,} ${var^}   case-modifying expansion (4.0)
#   2. mapfile / readarray                                          (4.0)
#   3. declare -A / local -A / typeset -A  associative arrays        (4.0)
#   4. &>>                                 append stdout+stderr      (4.0)
#   5. ;;&  and  ;&                        case fall-through         (4.0)
#   6. shopt -s globstar                   ** recursive glob         (4.0)
#
# Full-line comments are stripped before matching, so a script may name a
# construct in prose while not using it. A line needing a deliberate
# exception carries a trailing `# bash32-ok` marker.
#
# Scope: every *.sh under content/ plus every executable in bin/.
# Exit: 0 clean, 1 findings, 2 usage error.

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *)  script_path="$(cd "$(dirname "$script_path")" && pwd)/$link_target" ;;
  esac
done
REPO_ROOT="$(cd "$(dirname "$script_path")/.." && pwd)"
cd "$REPO_ROOT"

if [ -t 1 ]; then
  C_RED=$'\033[31m'; C_GRAY=$'\033[90m'; C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GRAY=""; C_BOLD=""; C_RESET=""
fi

# name<TAB>extended-regex. Kept as a parallel-array pair: bash 3.2 has no
# associative arrays, which is the very thing this script is here to enforce.
CHECK_NAMES=(
  'case-modifying expansion ${var,,} / ${var^^}'  # bash32-ok
  'mapfile / readarray'  # bash32-ok
  'associative array (declare -A)'  # bash32-ok
  'append-both redirect (&>>)'  # bash32-ok
  'case fall-through (;;& or ;&)'  # bash32-ok
  'globstar (**)'  # bash32-ok
)
CHECK_RES=(
  '\$\{[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?(,,?|\^\^?)([^}]*)?\}'  # bash32-ok
  '(^|[^A-Za-z0-9_])(mapfile|readarray)[ 	]'  # bash32-ok
  '(declare|local|typeset)[ 	]+-[A-Za-z]*A'  # bash32-ok
  '&>>'  # bash32-ok
  ';;&|[^;];&([ 	]|$)'  # bash32-ok
  'shopt[ 	]+-s[ 	]+globstar'  # bash32-ok
)

enumerate() {
  if [ -d content ]; then
    find content -name '*.sh' -type f | sort
  fi
  if [ -d bin ]; then
    find bin -type f -perm -u+x | sort
  fi
}

findings=0
scanned=0

while IFS= read -r file; do
  [ -n "$file" ] || continue
  scanned=$(( scanned + 1 ))

  # Strip full-line comments and `# bash32-ok` lines, keeping line numbers.
  stripped="$(awk '{ if ($0 ~ /^[ \t]*#/ || $0 ~ /#[ \t]*bash32-ok/) print ""; else print $0 }' "$file")"

  i=0
  while [ "$i" -lt "${#CHECK_RES[@]}" ]; do
    re="${CHECK_RES[$i]}"
    name="${CHECK_NAMES[$i]}"
    hits="$(printf '%s\n' "$stripped" | grep -nE "$re" || true)"
    if [ -n "$hits" ]; then
      while IFS= read -r hit; do
        [ -n "$hit" ] || continue
        lineno="${hit%%:*}"
        text="${hit#*:}"
        printf '%s✗%s %s%s:%s%s  %s\n' \
          "$C_RED" "$C_RESET" "$C_BOLD" "$file" "$lineno" "$C_RESET" "$name"
        printf '   %s%s%s\n' "$C_GRAY" "$(printf '%s' "$text" | sed 's/^[ \t]*//' | cut -c1-96)" "$C_RESET"
        findings=$(( findings + 1 ))
      done <<EOF
$hits
EOF
    fi
    i=$(( i + 1 ))
  done
done <<EOF
$(enumerate)
EOF

echo ""
if [ "$findings" -gt 0 ]; then
  printf '%sbash 3.2 gate: %d finding(s) across %d scanned file(s).%s\n' \
    "$C_RED" "$findings" "$scanned" "$C_RESET"
  echo "These parse fine under bash 4+ and fail at RUNTIME on stock macOS."
  echo "Rewrite for 3.2, or mark a deliberate exception with '# bash32-ok'."
  exit 1
fi

printf 'bash 3.2 gate: clean (%d files scanned).\n' "$scanned"
exit 0
