#!/usr/bin/env bash
# bin/test-pipeline — regression tests for the build → test → deploy chain.
# Repo tooling: lives in bin/, is not registered in rasa.json, and is never
# installed into a consumer.
#
# Installs the Element into a fresh project with bin/init and drives the real
# pipeline there: a small "web app" whose build copies src/ to dist/, a web
# runtime served by python3 -m http.server, a unit test, a real HTTP e2e test
# and a smoke test that checks the deployed copy. Every case starts from the
# same committed base with no records.
#
#   happy     build → test (gate + e2e with runtime up/health/down) →
#             staging deploy and prod release ship the TESTED build (20-build
#             reused, never rerun) and 60-verify smoke-checks each one
#   build     refuses a dirty tree and a repo without commits; a build that
#             writes unignored files fails; a declared artifact that does not
#             exist fails
#   test      refuses no build of HEAD, a tampered artifact, a dirty tree; a
#             failing e2e test, a runtime that exits, one never healthy, one
#             with no commands.start, an e2e suite listing no tests, and a
#             missing gate suite all FAIL — and no runtime is left running,
#             including when the test run itself is killed mid-e2e
#   deploy    staging/prod refused with no test, a failed test, a stale test
#             (new commit), a tampered artifact, a build made for another
#             environment, and prod without smoke.md — under --dry-run,
#             --skip-gates and --skip-tests too; dev warns and deploys, and a
#             build stage using $BUILD_ARTIFACTS works there
#   verify    a smoke failure after deploy fails the deploy at 60-verify
#   records   the chain's records never make the tree dirty for git-clean
#
# Portable on purpose: bash 3.2, POSIX tools, python3, curl.
# Exit 0 only if every case passes.

set -u
here="$(cd "$(dirname "$0")" && pwd -P)"
ELEMENT="$(cd "$here/.." && pwd -P)"
command -v curl >/dev/null 2>&1 || { echo "test-pipeline: curl is required"; exit 2; }

T="$(mktemp -d "${TMPDIR:-/tmp}/test-pipeline.XXXXXX")" || exit 2
T="$(cd "$T" && pwd -P)"
PORT=$(( 20000 + ($$ % 20000) ))
cleanup() {
  pkill -f "http.server $PORT" 2>/dev/null || true
  rm -rf "$T"
}
trap cleanup EXIT
export GIT_CONFIG_GLOBAL=/dev/null HOME="$T/home" FORCE_APPROVAL=1
mkdir -p "$HOME"
unset RASA_ROOT RASA_ACTOR

pass=0; fail=0
ok()  { pass=$((pass + 1)); printf '  ok    %s\n' "$1"; }
bad() { fail=$((fail + 1)); printf '  FAIL  %s\n        %s\n' "$1" "$2"; }
# expect <name> <want-rc> <pattern|""> <cmd...> — run, check rc and output.
expect() {
  local name="$1" want="$2" pat="$3" out rc; shift 3
  out="$("$@" 2>&1)"; rc=$?
  if [ "$rc" != "$want" ]; then
    bad "$name" "want rc=$want, got rc=$rc — $(printf '%s' "$out" | grep -E '✗|⚠|error' | head -3 | tr '\n' '|')"
  elif [ -n "$pat" ] && ! printf '%s\n' "$out" | grep -q -- "$pat"; then
    bad "$name" "output lacks /$pat/: $(printf '%s' "$out" | tail -5 | tr '\n' '|')"
  else
    ok "$name"
  fi
}
server_down() {
  if curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/"; then
    bad "$1" "a runtime is still listening on :$PORT after the test phase"
    pkill -f "http.server $PORT" 2>/dev/null || true
  else
    ok "$1"
  fi
}
q() { "$@" >/dev/null 2>&1; }
commit() { git add -A && git commit -qm "$1"; }

# ── the project ────────────────────────────────────────────────────────
P="$T/proj"; mkdir -p "$P" && cd "$P" || exit 2
git init -q -b main . && git config user.email t@example.com && git config user.name tester
"$ELEMENT/bin/init" . </dev/null >/dev/null 2>&1 || { echo "bin/init failed"; exit 2; }
mkdir -p src && echo "hello from the app" > src/index.html
printf 'dist/\nkit/\nlive-*/\n' >> .gitignore
cat > build/stages/20-build.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
rm -rf dist && mkdir -p dist && cp src/index.html dist/
echo "dist" >> "$BUILD_ARTIFACTS"
EOF
for e in local staging prod; do
  mkdir -p "build/environments/$e"
  printf '#!/usr/bin/env bash\nset -e\nrm -rf live-%s && cp -r dist live-%s\n' "$e" "$e" > "build/environments/$e/deploy.sh"
  chmod +x "build/environments/$e/deploy.sh"
done
mkdir -p .claude/runtimes
cat > .claude/runtimes/web.md <<EOF
---
name: web
kind: dev-server
commands:
  start: "python3 -m http.server $PORT --bind 127.0.0.1 --directory dist"
health_check:
  url: "http://127.0.0.1:$PORT/index.html"
  expect_status: 200
  timeout_seconds: 15
---
EOF
stamp() { printf -- '---\nname: %s\nkind: test\ntest_kind: %s\nstatus: active\nrun_command: "%s"\n---\n' "$1" "$2" "$3" > "tests/stamps/$1.md"; }
stamp unit-src unit 'test -f src/index.html'
stamp e2e-home e2e 'curl -sf $RUNTIME_WEB_HEALTH_URL | grep -q hello'
stamp smoke-live smoke 'test -f live-$ENVIRONMENT/index.html'
python3 - <<'PY'
p = 'tests/suites/pre-deploy.md'; s = open(p).read()
open(p, 'w').write(s.replace("tests:\n#  - your-stamp-name", "tests:\n  - unit-src", 1))
open('tests/suites/e2e.md', 'w').write("---\nname: e2e\nkind: test-suite\nsuite_kind: gate\nruntimes: [web]\ntests:\n  - e2e-home\n---\n")
open('tests/suites/smoke.md', 'w').write("---\nname: smoke\nkind: test-suite\nsuite_kind: smoke\ntests: [smoke-live]\n---\n")
PY
commit base
BASE="$(git rev-parse HEAD)"
reset() { git reset -q --hard "$BASE" && git clean -fdq && rm -rf dist live-*; }

# edit <file> <python-replace-from> <to> — a one-substitution edit, committed.
edit() {
  python3 - "$1" "$2" "$3" <<'PY'
import sys
p, a, b = sys.argv[1:4]; s = open(p).read()
assert a in s, (p, a)
open(p, 'w').write(s.replace(a, b, 1))
PY
  commit "edit $1"
}

echo "happy path"
reset
expect "deploy before any build is refused at staging" 1 "no passing test run" ./build/deploy --env=staging --intent=deploy
expect "build records the commit and fingerprints dist" 0 "1 artifact(s)" ./build/build
expect "test runs the gate, then e2e against the started runtime" 0 "e2e: passed" ./build/test
server_down "the runtime is stopped after a passing test"
expect "staging ships the tested build without rebuilding" 0 "20-build (reusing BLD-" ./build/deploy --env=staging --intent=deploy
expect "60-verify smoke-checks staging after the deploy" 0 "'staging' verified after deploy" ./build/deploy --env=staging --intent=deploy
expect "prod release ships the tested build and verifies it" 0 "'prod' verified after deploy" ./build/deploy --env=prod --intent=release
expect "the chain's records never dirty the tree for git-clean" 0 "Working tree clean" ./build/deploy --env=staging --intent=deploy

echo "build"
reset
echo x >> src/index.html
expect "a dirty tree is refused" 3 "not a build of any commit" ./build/build
reset
edit build/stages/20-build.sh 'echo "dist" >>' 'echo leak > leaked.txt; echo "dist" >>'
expect "a build that writes unignored files fails" 1 "add its outputs to .gitignore" ./build/build
reset
edit build/stages/20-build.sh 'echo "dist" >>' 'echo "nope/missing" >>'
expect "a declared artifact that does not exist fails" 1 "does not exist" ./build/build
E="$T/empty"; mkdir -p "$E" && (cd "$E" && git init -q . && "$ELEMENT/bin/init" . </dev/null >/dev/null 2>&1)
expect "a repository with no commits is refused" 3 "no commits" "$E/build/build"

echo "test"
reset
expect "no build of HEAD is refused" 3 "run ./build/build first" ./build/test
reset; q ./build/build; echo tampered >> dist/index.html
expect "a tampered artifact is refused" 3 "not what was built" ./build/test
reset; q ./build/build; echo x >> src/index.html
expect "a dirty tree is refused" 3 "tree differs from HEAD" ./build/test
reset; edit tests/stamps/e2e-home.md 'grep -q hello' 'grep -q nope'; q ./build/build
expect "a failing e2e test fails the run" 1 "e2e suite failed" ./build/test
server_down "the runtime is stopped after a failing e2e test"
reset; edit .claude/runtimes/web.md "python3 -m http.server $PORT" 'python3 -c "import sys; sys.exit(4)"; true'; q ./build/build
expect "a runtime that exits on start fails the run" 1 "exited before it was healthy" ./build/test
reset; edit .claude/runtimes/web.md "$PORT/index.html" "$((PORT + 1))/index.html"
edit .claude/runtimes/web.md "timeout_seconds: 15" "timeout_seconds: 2"; q ./build/build
expect "a runtime never healthy times out and fails" 1 "not healthy after 2s" ./build/test
server_down "the unhealthy runtime is stopped"
reset; edit .claude/runtimes/web.md "  start: " "  begin: "; q ./build/build
expect "a runtime with no commands.start fails, naming the field" 1 "no commands.start" ./build/test
reset; edit tests/stamps/e2e-home.md 'curl -sf' 'sleep 60; curl -sf'; q ./build/build
./build/test > "$T/killed.log" 2>&1 &
tp=$!
n=0; until grep -q "healthy" "$T/killed.log" 2>/dev/null || [ "$n" -ge 60 ]; do sleep 0.5; n=$((n + 1)); done
kill -TERM "$tp" 2>/dev/null
# Promptly — not when the hung test finishes. Checked BEFORE waiting on it.
n=0; while curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/" && [ "$n" -lt 10 ]; do sleep 0.5; n=$((n + 1)); done
server_down "a test run killed mid-e2e stops its runtime within 5s"
wait "$tp" 2>/dev/null; krc=$?
[ "$krc" -ne 0 ] && ok "  … and exits non-zero (rc=$krc)" || bad "  … and exits non-zero" "rc=0"
pgrep -f "sleep 60" >/dev/null 2>&1 && { bad "  … and the hung test is killed too" "sleep 60 still running"; pkill -f "sleep 60"; } || ok "  … and the hung test is killed too"
reset; edit tests/suites/e2e.md "  - e2e-home" "  # none"; q ./build/build
expect "an e2e suite that lists no tests fails" 1 "e2e suite failed" ./build/test
reset; edit tests/stamps/e2e-home.md 'status: active' 'status: active
runtimes_required: [web, api]'; q ./build/build
expect "an e2e test needing a runtime the suite never starts fails, naming it" 1 "needs runtime 'api'" ./build/test
server_down "  … and nothing was started"
reset; git rm -q tests/suites/pre-deploy.md; commit "no gate"; q ./build/build
expect "no gate suite fails the run" 1 "no gate suite" ./build/test

echo "deploy gate"
reset; edit tests/stamps/e2e-home.md 'grep -q hello' 'grep -q nope'; q ./build/build; q ./build/test
expect "staging is refused when the only test failed" 1 "did not pass" ./build/deploy --env=staging --intent=deploy
reset; q ./build/build; q ./build/test; echo y > src/other.html; commit "new commit"
expect "a test of an older commit does not ship the new one" 1 "no passing test run" ./build/deploy --env=staging --intent=deploy
reset; q ./build/build; q ./build/test; echo tampered >> dist/index.html
expect "an artifact changed after its test is refused" 1 "artifacts changed" ./build/deploy --env=staging --intent=deploy
expect "  … under --dry-run --skip-gates --skip-tests too" 1 "REFUSED" ./build/deploy --env=staging --intent=deploy --dry-run --skip-gates --skip-tests
reset; q ./build/build --env=staging; q ./build/test
expect "a build made for staging cannot go to prod" 1 "built for 'staging', not 'prod'" ./build/deploy --env=prod --intent=release
expect "  … and does go to staging" 0 "reusing BLD-" ./build/deploy --env=staging --intent=deploy
reset; git rm -q tests/suites/smoke.md; commit "no smoke"; q ./build/build; q ./build/test
expect "prod without smoke.md is refused before deploying" 1 "no tests/suites/smoke.md" ./build/deploy --env=prod --intent=release
[ -d live-prod ] && bad "  … and nothing was deployed" "live-prod exists" || ok "  … and nothing was deployed"
reset
expect "dev warns without a test and still deploys" 0 "warning only" ./build/deploy --env=local --intent=deploy
expect "  … its in-pipeline build can use \$BUILD_ARTIFACTS" 0 "Stage: 20-build" ./build/deploy --env=local --intent=deploy

echo "post-deploy verify"
reset; edit tests/stamps/smoke-live.md 'test -f' 'test ! -f'; q ./build/build; q ./build/test
expect "a smoke failure after deploy fails the deploy at 60-verify" 1 "FAILED verification after deploy" ./build/deploy --env=staging --intent=deploy
rec="$(ls deploys/records/DEP-*staging*.md 2>/dev/null | tail -1)"
if [ -n "$rec" ] && grep -q "60-verify" "$rec"; then ok "  … and the ship log records failed at 60-verify"
else bad "  … and the ship log records failed at 60-verify" "record: ${rec:-none}"; fi

echo "hardening (v0.58.0)"
# timeouts: a hung test is killed at its limit, with what it started
reset; stamp unit-src unit 'sleep 30 & sleep 30; true'
edit tests/stamps/unit-src.md 'status: active' 'status: active
timeout_seconds: 2'
q ./build/build
expect "a hung test is killed at its timeout_seconds and fails" 1 "timed out after 2s" ./build/test
pgrep -f "sleep 30" >/dev/null 2>&1 && { bad "  … and everything it started is killed" "sleep 30 still running"; pkill -f "sleep 30"; } || ok "  … and everything it started is killed"
# newest test run wins: one commit, a genuine pass then a genuine failure
reset; stamp unit-src unit 'test -z \"$FAIL_NOW\"'; commit "fail on demand"; q ./build/build
q ./build/test; env FAIL_NOW=1 ./build/test >/dev/null 2>&1
expect "an earlier pass does not outvote the newest failed run" 1 "did not pass" ./build/deploy --env=staging --intent=deploy
q ./build/test
expect "  … and a fresh pass restores it" 0 "deploy complete" ./build/deploy --env=staging --intent=deploy
# aborted runs refuse
reset; q ./build/build; q ./build/test
edit tests/stamps/e2e-home.md 'curl -sf' 'sleep 60; curl -sf'; q ./build/build
./build/test > "$T/ab.log" 2>&1 & tp=$!
n=0; until grep -q "healthy" "$T/ab.log" 2>/dev/null || [ "$n" -ge 60 ]; do sleep 0.5; n=$((n + 1)); done
kill -TERM "$tp" 2>/dev/null; wait "$tp" 2>/dev/null
expect "a killed test run leaves an aborted record the gate refuses" 1 "aborted" ./build/deploy --env=staging --intent=deploy
pkill -f "sleep 60" 2>/dev/null || true
# locks
reset; q ./build/build; q ./build/test
mkdir -p deploys/locks/staging.lock; printf 'pid=%s\nhost=%s\nactor=someone\nstarted=now\n' "$$" "$(hostname)" > deploys/locks/staging.lock/owner
expect "a deploy is refused while another holds the environment's lock" 1 "another run holds the lock" ./build/deploy --env=staging --intent=deploy
printf 'pid=999999\nhost=%s\nactor=someone\nstarted=then\n' "$(hostname)" > deploys/locks/staging.lock/owner
expect "a stale lock (dead pid) is taken over" 0 "took over a stale lock" ./build/deploy --env=staging --intent=deploy
[ -d deploys/locks/staging.lock ] && bad "  … and released after the deploy" "lock still present" || ok "  … and released after the deploy"
mkdir -p builds/.lock; printf 'pid=%s\nhost=%s\n' "$$" "$(hostname)" > builds/.lock/owner
expect "a build is refused while another build runs" 3 "another run holds the lock" ./build/build
rm -rf builds/.lock
# staging before prod
reset; q ./build/build; q ./build/test
expect "prod refuses a build that was never deployed to staging" 1 "has not been deployed to staging" ./build/deploy --env=prod --intent=release
q ./build/deploy --env=staging --intent=deploy
expect "  … and ships it once staging verified it" 0 "was verified in staging" ./build/deploy --env=prod --intent=release
rec="$(ls deploys/records/DEP-*prod*.md | tail -1)"
grep -q "^build: BLD-" "$rec" && ok "the deploy record names the build it shipped" || bad "the deploy record names the build it shipped" "$rec"
# stale outputs
reset; q ./build/build; echo stale > dist/old.html; q ./build/build
[ -f dist/old.html ] && bad "a rebuild clears the previous build's outputs" "dist/old.html survived" || ok "a rebuild clears the previous build's outputs"
# verify retries and rollback
reset; stamp smoke-live smoke 'test -f live-$ENVIRONMENT/index.html && { test -f '"$T"'/warm || { touch '"$T"'/warm; false; }; }'
commit "flaky smoke"; rm -f "$T/warm"; q ./build/build; q ./build/test
expect "smoke is retried while the environment warms up" 0 "attempt 2/" env VERIFY_DELAY=0 ./build/deploy --env=staging --intent=deploy
reset; q ./build/build; q ./build/test; q ./build/deploy --env=staging --intent=deploy
printf '#!/usr/bin/env bash\necho "to=$ROLLBACK_TO_DEPLOY tag=$ROLLBACK_TO_TAG" > "%s/rolled"\n' "$T" > build/environments/staging/rollback.sh
chmod +x build/environments/staging/rollback.sh
edit tests/stamps/smoke-live.md 'test -f' 'test ! -f'; q ./build/build; q ./build/test
expect "a failed verification runs rollback.sh and still fails the deploy" 1 "Rolling 'staging' back to DEP-" env VERIFY_DELAY=0 ./build/deploy --env=staging --intent=deploy
grep -q "to=DEP-" "$T/rolled" 2>/dev/null && ok "  … naming the last verified deploy to go back to" || bad "  … naming the last verified deploy to go back to" "$(cat "$T/rolled" 2>/dev/null)"
# migrations run before the code, and a failure stops the deploy
reset; q ./build/build; q ./build/test
printf '#!/usr/bin/env bash\ntouch migrated\n' > build/environments/staging/migrate.sh; chmod +x build/environments/staging/migrate.sh
printf '#!/usr/bin/env bash\nset -e\ntest -f migrated\nrm -rf live-staging && cp -r dist live-staging\n' > build/environments/staging/deploy.sh
printf 'migrated\n' >> .gitignore; commit "migrations"; q ./build/build; q ./build/test
expect "45-migrate runs before 50-deploy" 0 "migrations applied" ./build/deploy --env=staging --intent=deploy
printf '#!/usr/bin/env bash\nexit 7\n' > build/environments/staging/migrate.sh; commit "bad migration"; q ./build/build; q ./build/test; rm -rf live-staging
expect "a failed migration stops the deploy before the code ships" 1 "failed at stage: 45-migrate" ./build/deploy --env=staging --intent=deploy
[ -d live-staging ] && bad "  … and nothing was deployed" "live-staging exists" || ok "  … and nothing was deployed"
# ship log fails closed at prod
reset; q ./build/build; q ./build/test; q ./build/deploy --env=staging --intent=deploy
cp .claude/skills/deploys/deploys.sh "$T/deploys.sh.bak"; printf '#!/usr/bin/env bash\nexit 1\n' > .claude/skills/deploys/deploys.sh
expect "prod refuses to ship unrecorded when the ship log cannot open" 1 "refusing an unrecorded production deploy" ./build/deploy --env=prod --intent=release
cp "$T/deploys.sh.bak" .claude/skills/deploys/deploys.sh
# e2e dependencies and stop commands
reset; edit .claude/runtimes/web.md 'health_check:' 'depends_on:
  - { name: database, check: "false" }
health_check:'; q ./build/build
expect "a runtime whose dependency check fails is not started" 1 "dependency 'database' is not available" ./build/test
server_down "  … and nothing was started"
reset; edit .claude/runtimes/web.md 'health_check:' "  stop: \"touch $T/stopped\"
health_check:"; q ./build/build
python3 - <<'PY'
p = '.claude/runtimes/web.md'; s = open(p).read()
i = s.index('  stop:'); line = s[i:s.index('\n', i) + 1]
s = s.replace(line, '', 1).replace('commands:\n', 'commands:\n' + line, 1)
open(p, 'w').write(s)
PY
commit "stop command"; q ./build/build; rm -f "$T/stopped"; q ./build/test
[ -f "$T/stopped" ] && ok "teardown runs the runtime's commands.stop" || bad "teardown runs the runtime's commands.stop" "no marker"

echo "adversarial (v0.58.0)"
# 1. an environment path alias cannot dodge the class
reset
expect "--env=./prod is refused as a bad name" 2 "bad environment name" ./build/deploy --env=./prod --intent=deploy
mkdir -p build/environments/nowhere
expect "an environment the registry does not list is refused" 2 "not in .claude/environments.json" ./build/deploy --env=nowhere --intent=deploy
rm -rf build/environments/nowhere
# 2. an unreadable registry refuses, never guesses
cp .claude/environments.json "$T/envs.bak"; printf '{ "environments": { "eu": { "class": "prod" }, } }' > .claude/environments.json
expect "a malformed registry refuses the deploy" 2 "cannot be read" ./build/deploy --env=staging --intent=deploy
cp "$T/envs.bak" .claude/environments.json
# 3. artifacts rewritten by a later stage stop the deploy
reset; printf '#!/usr/bin/env bash\necho "NEVER TESTED" > dist/index.html\n' > build/stages/25-sneak.sh; commit "sneaky stage"
q ./build/build; q ./build/test
expect "a stage that rewrites the tested artifacts stops the deploy" 1 "artifacts changed during stage 25-sneak" ./build/deploy --env=staging --intent=deploy
[ -d live-staging ] && bad "  … before anything ships" "live-staging exists" || ok "  … before anything ships"
# 4. a stray server on the runtime's port is refused, not tested
reset; q ./build/build
( cd "$T" && mkdir -p stray && echo hello > stray/index.html && python3 -m http.server "$PORT" --bind 127.0.0.1 --directory stray >/dev/null 2>&1 ) & stray=$!
n=0; until curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/" || [ "$n" -ge 40 ]; do sleep 0.25; n=$((n + 1)); done
expect "a health check that passes before the runtime starts is refused" 1 "already passes before it was started" ./build/test
kill "$stray" 2>/dev/null; pkill -f "http.server $PORT" 2>/dev/null; sleep 0.5
# 5. a dry-run is not a staging deploy
reset; q ./build/build; q ./build/test; q ./build/deploy --env=staging --intent=deploy --dry-run
expect "a staging --dry-run does not satisfy staging-before-prod" 1 "has not been deployed to staging" ./build/deploy --env=prod --intent=release
# 6. symlinks cannot smuggle untested content
reset; edit build/stages/20-build.sh 'echo "dist" >>' 'ln -s ../src dist/assets; echo "dist" >>'
expect "an artifact symlink pointing outside the artifact fails the build" 1 "points outside it" ./build/build
# 8. ids order within one second
. build/gates/verify-lib.sh
a="$(vl_new_record "$T/ids" TST)"; b="$(vl_new_record "$T/ids" TST)"; c="$(vl_new_record "$T/ids" TST)"
[ "$(ls "$T/ids"/TST-*.md | tail -1)" = "$c" ] && ok "records made in one second sort in creation order" || bad "records made in one second sort in creation order" "$(ls "$T/ids")"
# 10. monorepo: an uncommitted change outside the project is dirty
M="$T/mono"; mkdir -p "$M/app" "$M/shared" && ( cd "$M" && git init -q -b main . && git config user.email t@example.com && git config user.name tester && echo v1 > shared/lib.txt && ( cd app && "$ELEMENT/bin/init" . </dev/null >/dev/null 2>&1 ) && printf 'app/kit/\n' > .gitignore && git add -A && git commit -qm mono )
echo v2 > "$M/shared/lib.txt"
expect "monorepo: an uncommitted edit outside the project refuses the build" 3 "shared/lib.txt" "$M/app/build/build"
# 13. edits hidden with --skip-worktree are still dirty
reset; git update-index --skip-worktree src/index.html; echo hidden >> src/index.html
expect "an edit hidden with --skip-worktree refuses the build" 3 "hidden" ./build/build
git update-index --no-skip-worktree src/index.html
# 14. a path containing = is a path, not a label
reset; edit build/stages/20-build.sh 'echo "dist" >>' 'echo "dist/app-build=42.tar.gz" >>'
expect "a missing path containing '=' fails instead of passing as a label" 1 "does not exist" ./build/build
# source fingerprint: committing the chain's records does not invalidate it
reset; q ./build/build; q ./build/test; git add -A builds tests/runs; git commit -qm "commit the records"
expect "committing the records keeps the build verified (source fingerprint)" 0 "reusing BLD-" ./build/deploy --env=staging --intent=deploy
# BUILD_TAG is unique per build
reset; q ./build/build; t1="$(ls builds/records/BLD-*.md | tail -1)"; q ./build/build; t2="$(ls builds/records/BLD-*.md | tail -1)"
[ "$(sed -n 's/^build_tag: //p' "$t1")" != "$(sed -n 's/^build_tag: //p' "$t2")" ] && ok "two builds of one commit get different BUILD_TAGs" || bad "two builds of one commit get different BUILD_TAGs" "same tag"
# artifact-less builds refused at staging
reset; edit build/stages/20-build.sh 'echo "dist" >> "$BUILD_ARTIFACTS"' 'true'; q ./build/build; q ./build/test
expect "a build that declared no artifacts is refused at staging" 1 "declared no artifacts" ./build/deploy --env=staging --intent=deploy
reset; edit build/stages/20-build.sh 'echo "dist" >> "$BUILD_ARTIFACTS"' 'echo "source=commit" >> "$BUILD_ARTIFACTS"'; q ./build/build; q ./build/test
expect "  … unless it declared source=commit on purpose" 0 "deploy complete" ./build/deploy --env=staging --intent=deploy
# --skip-tests skips only the test stage
reset; printf '#!/usr/bin/env bash\necho ATTEST-RAN\n' > build/stages/55-attest.sh; commit attest
expect "--skip-tests does not skip a stage merely containing 'test'" 0 "ATTEST-RAN" ./build/deploy --env=local --intent=deploy --skip-tests
# approval kind is recorded truthfully
reset; q ./build/build; q ./build/test; q ./build/deploy --env=staging --intent=deploy
q ./build/deploy --env=prod --intent=release
grep -q "^approval: forced" "$(ls deploys/records/DEP-*prod*.md | tail -1)" && ok "a FORCE_APPROVAL prod release records approval: forced" || bad "a FORCE_APPROVAL prod release records approval: forced" "$(grep approval "$(ls deploys/records/DEP-*prod*.md | tail -1)")"
grep -q "^approval: none" "$(ls deploys/records/DEP-*staging*.md | tail -1)" && ok "a staging deploy records approval: none" || bad "a staging deploy records approval: none" "wrong"

echo
echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
