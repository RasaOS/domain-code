#!/usr/bin/env bash
#
# bin/check-manifest — verify rasa.json is a complete inventory of the Element.
#
# bin/init and /sync are manifest-driven: they install exactly what
# rasa.json declares. If a file is committed to content/ or seed/ but
# never registered in rasa.json, it silently never ships — and nothing
# else catches it. This script does.
#
# Three checks:
#   1. Coverage — every git-tracked file under content/ and seed/ is
#      registered in rasa.json (matched by an exact element.files /
#      seed.files 'from', or by an ancestor directory entry).
#   2. Dangling — every rasa.json 'from' points at a path that exists.
#   3. Vendored — every file vendored.json records is byte-identical to the
#      upstream release it was copied from (sha256). A vendored file edited
#      in place is a fork nobody decided on; this is what catches it.
#
# Usage: bin/check-manifest [--vendor-from <upstream-checkout>]
#   --vendor-from also compares each vendored file against that checkout's
#   working tree and lists what moved — the re-vendoring aid. It never
#   changes the verdict of check 3, which is always against the recorded pin.
#
# Run it before tagging an Element release, or wire it into CI.
#
# Exit: 0 if the manifest is a complete, accurate inventory; 1 otherwise.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MANIFEST="$REPO_ROOT/rasa.json"
VENDORED="$REPO_ROOT/vendored.json"

VENDOR_FROM=""
while [ $# -gt 0 ]; do
  case "$1" in
    --vendor-from)
      [ $# -ge 2 ] || { echo "ERROR: --vendor-from needs a path" >&2; exit 2; }
      VENDOR_FROM="$2"; shift 2 ;;
    -h|--help) sed -n '3,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "ERROR: unknown argument: $1" >&2; exit 2 ;;
  esac
done

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: bin/check-manifest requires python3." >&2
  exit 1
fi
if [ ! -f "$MANIFEST" ]; then
  echo "ERROR: rasa.json not found at $MANIFEST" >&2
  exit 1
fi
if ! git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "ERROR: bin/check-manifest must run inside the Element's git repo." >&2
  exit 1
fi

python3 - "$REPO_ROOT" "$MANIFEST" "$VENDORED" "$VENDOR_FROM" <<'PYEOF'
import hashlib, json, os, subprocess, sys

repo, manifest_path, vendored_path, vendor_from = sys.argv[1:5]

try:
    manifest = json.load(open(manifest_path))
except (OSError, ValueError) as exc:
    print("ERROR: could not parse rasa.json: %s" % exc)
    sys.exit(1)

# Every 'from' the manifest declares (element-managed + seed), slash-stripped.
froms = []
for section in ("element", "seed"):
    for entry in manifest.get(section, {}).get("files", []):
        froms.append(entry["from"].rstrip("/"))
from_set = set(froms)

# The real inventory: git-tracked files under content/ and seed/.
tracked = subprocess.check_output(
    ["git", "-C", repo, "ls-files", "content", "seed"], text=True
).splitlines()
tracked = [t for t in tracked if t]


def covered(path):
    """True if path equals a 'from', or any ancestor directory is a 'from'."""
    if path in from_set:
        return True
    parts = path.split("/")
    return any("/".join(parts[:i]) in from_set for i in range(1, len(parts)))


uncovered = sorted(p for p in tracked if not covered(p))
dangling = sorted(f for f in froms if not os.path.exists(os.path.join(repo, f)))


def sha256_of(path):
    with open(path, "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()


# Check 3 — vendored files match their recorded upstream release.
vendor_bad = []
vendor_moved = []
vendor_count = 0
if os.path.exists(vendored_path):
    try:
        vendored = json.load(open(vendored_path))
    except (OSError, ValueError) as exc:
        vendored = {}
        vendor_bad.append("vendored.json does not parse: %s" % exc)
    for name, pin in sorted(vendored.items()):
        if name.startswith("_") or not isinstance(pin, dict):
            continue
        for entry in pin.get("files", []):
            vendor_count += 1
            local = os.path.join(repo, entry["path"])
            if not os.path.isfile(local):
                vendor_bad.append("%s (%s): missing" % (entry["path"], name))
                continue
            if sha256_of(local) != entry["sha256"]:
                vendor_bad.append("%s (%s %s): edited in place — differs from the "
                                  "recorded upstream bytes" % (entry["path"], name,
                                                               pin.get("version", "?")))
            if vendor_from:
                upstream = os.path.join(vendor_from, entry["upstream"])
                if not os.path.isfile(upstream):
                    vendor_moved.append("%s: gone upstream (%s)" % (entry["path"], entry["upstream"]))
                elif sha256_of(upstream) != entry["sha256"]:
                    vendor_moved.append("%s: changed upstream (%s)" % (entry["path"], entry["upstream"]))

problems = len(uncovered) + len(dangling) + len(vendor_bad)

print("bin/check-manifest — rasa.json coverage")
print()

if uncovered:
    print("UNREGISTERED — committed under content/ or seed/, absent from rasa.json:")
    for p in uncovered:
        print("  x  %s" % p)
    print()

if dangling:
    print("DANGLING — a rasa.json 'from' points at a path that does not exist:")
    for f in dangling:
        print("  x  %s" % f)
    print()

if vendor_bad:
    print("VENDORED — a file copied from another Element no longer matches its pin:")
    for v in vendor_bad:
        print("  x  %s" % v)
    print("     Fix it upstream, release it, and re-vendor; never edit the copy.")
    print()

if vendor_from:
    print("UPSTREAM (%s) vs the recorded pin — informational, not a failure:" % vendor_from)
    if vendor_moved:
        for v in vendor_moved:
            print("  ~  %s" % v)
    else:
        print("  =  every vendored file is identical upstream")
    print()

if problems == 0:
    print("OK   rasa.json is a complete inventory.")
    print("     %d tracked files under content/ + seed/, all registered." % len(tracked))
    if vendor_count:
        print("     %d vendored files, all byte-identical to their pinned upstream." % vendor_count)
    sys.exit(0)

print("FAIL %d problem(s) — rasa.json and the Element tree have drifted." % problems)
sys.exit(1)
PYEOF
